###  https://w3id.org/nis2onto-ops#ControlGovernance
nis2onto-ops:ControlGovernance rdf:type owl:Class ;
                               rdfs:comment "Organizational grouping for the concepts used to define, scope, and evaluate compliance controls."@en ;
                               rdfs:label "Control Governance"@en .


###  https://w3id.org/nis2onto-ops#ControlRuling
nis2onto-ops:ControlRuling rdf:type owl:Class ;
                           rdfs:subClassOf nis2onto-ops:ControlGovernance ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty nis2onto-ops:evidencedBy ;
                                             owl:someValuesFrom nis2onto-ops:EvidenceRecord
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty nis2onto-ops:hasControlScope ;
                                             owl:someValuesFrom nis2onto-ops:ControlScope
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty nis2onto-ops:hasControlStatus ;
                                             owl:someValuesFrom nis2onto-ops:ControlStatus
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty nis2onto-ops:hasRemediationScore ;
                                             owl:someValuesFrom nis2onto-ops:RemediationScore
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty nis2onto-ops:usesRule ;
                                             owl:someValuesFrom nis2onto-ops:ComplianceRule
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty nis2onto-ops:hasTimestamp ;
                                             owl:someValuesFrom xsd:dateTime
                                           ] ;
                           rdfs:comment "Reified, auditable record of a single compliance judgement: the scope it evaluates, the evidence records it was computed from, the status it produced, and when and by which rule it was derived."@en ;
                           rdfs:label "Control Ruling"@en .


###  https://w3id.org/nis2onto-ops#ControlScope
nis2onto-ops:ControlScope rdf:type owl:Class ;
                          rdfs:subClassOf nis2onto-ops:ControlGovernance ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty nis2onto-ops:hasInScopeAsset ;
                                            owl:someValuesFrom nis2onto-ops:Asset
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty nis2onto-ops:hasInScopeControlTheme ;
                                            owl:someValuesFrom nis2onto-ops:ControlTheme
                                          ] ;
                          rdfs:comment "Boundary of a compliance evaluation, defined by the asset(s) and control theme(s) it covers."@en ;
                          rdfs:label "Control Scope"@en .


###  https://w3id.org/nis2onto-ops#ControlStatus
nis2onto-ops:ControlStatus rdf:type owl:Class ;
                           rdfs:subClassOf nis2onto-ops:ControlGovernance ;
                           rdfs:comment "Outcome classification of a control derivation."@en ;
                           rdfs:label "Control Status"@en .


###  https://w3id.org/nis2onto-ops#ControlTheme
nis2onto-ops:ControlTheme rdf:type owl:Class ;
                          rdfs:subClassOf nis2onto-ops:ControlGovernance ;
                          rdfs:comment "A category of security controls, such as authentication or incident response, that compliance is evaluated against."@en ;
                          rdfs:label "Control Theme"@en .


###  https://w3id.org/nis2onto-ops#Criticality
nis2onto-ops:Criticality rdf:type owl:Class ;
                         rdfs:subClassOf nis2onto-ops:RiskRating ;
                         rdfs:comment "Asset criticality classification: Critical, High, Medium, Low, or N/A."@en ;
                         rdfs:label "Criticality"@en .


###  https://w3id.org/nis2onto-ops#CryptographicProtection
nis2onto-ops:CryptographicProtection rdf:type owl:Class ;
                                     rdfs:subClassOf nis2onto-ops:ControlTheme ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty nis2onto-ops:governedBy ;
                                                       owl:someValuesFrom nis2onto:Art21Par2-h-Entity
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty nis2onto-ops:relatedToENISATechnicalGuideSection ;
                                                       owl:hasValue "9.1"
                                                     ] ;
                                     rdfs:comment "Control theme covering the policy and use of cryptographic mechanisms to protect the confidentiality, integrity, and authenticity of data."@en ;
                                     rdfs:label "Cryptographic Protection"@en .


###  https://w3id.org/nis2onto-ops#CybersecuritySoftwareApplication
nis2onto-ops:CybersecuritySoftwareApplication rdf:type owl:Class ;
                                              rdfs:subClassOf nis2onto-ops:SoftwareApplication ;
                                              rdfs:comment "Software application dedicated to cybersecurity monitoring, detection, scanning, or protection."@en ;
                                              rdfs:label "Cybersecurity Software Application"@en .


###  https://w3id.org/nis2onto-ops#CybersecuritySoftwareModule
nis2onto-ops:CybersecuritySoftwareModule rdf:type owl:Class ;
                                         rdfs:subClassOf nis2onto-ops:SoftwareModule ;
                                         rdfs:comment "Software module dedicated to cybersecurity monitoring, detection, scanning, or protection functions."@en ;
                                         rdfs:label "Cybersecurity Software Module"@en .


###  https://w3id.org/nis2onto-ops#DCOPlaybook
nis2onto-ops:DCOPlaybook rdf:type owl:Class ;
                         rdfs:subClassOf nis2onto-ops:SecurityCatalogReference ;
                         rdfs:comment "Defensive Cyber Operations playbook describing a predefined incident-response procedure."@en ;
                         rdfs:label "DCO Playbook"@en .


###  https://w3id.org/nis2onto-ops#DataAsset
nis2onto-ops:DataAsset rdf:type owl:Class ;
                       rdfs:subClassOf nis2onto-ops:ITAsset ;
                       rdfs:comment "Stored data asset."@en ;
                       rdfs:label "Data Asset"@en .


###  https://w3id.org/nis2onto-ops#DataIntegrityAndTamperResistance
nis2onto-ops:DataIntegrityAndTamperResistance rdf:type owl:Class ;
                                              rdfs:subClassOf nis2onto-ops:ControlTheme ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty nis2onto-ops:governedBy ;
                                                                owl:someValuesFrom nis2onto:Art21Par2-b-Entity
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty nis2onto-ops:relatedToENISATechnicalGuideSection ;
                                                                owl:hasValue "3.2.5"
                                                              ] ;
                                              rdfs:comment "Control theme covering the protection of logs and recorded data from unauthorised access or modification."@en ;
                                              rdfs:label "Data Integrity and Tamper Resistance"@en .


###  https://w3id.org/nis2onto-ops#DetectionRule
nis2onto-ops:DetectionRule rdf:type owl:Class ;
                           rdfs:subClassOf nis2onto-ops:SecurityCatalogReference ;
                           rdfs:comment "Rule used by a detection system to identify malicious or anomalous behavior."@en ;
                           rdfs:label "Detection Rule"@en .


###  https://w3id.org/nis2onto-ops#Document
nis2onto-ops:Document rdf:type owl:Class ;
                      rdfs:subClassOf nis2onto:NIS2GeneralOntologicalEntity ;
                      rdfs:comment "A documentary artifact, e.g. a policy, procedure, certificate, or report."@en ;
                      rdfs:label "Document"@en .


###  https://w3id.org/nis2onto-ops#DocumentEvidenceRecord
nis2onto-ops:DocumentEvidenceRecord rdf:type owl:Class ;
                                    owl:equivalentClass [ owl:intersectionOf ( nis2onto-ops:EvidenceRecord
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty nis2onto-ops:recordsDocument ;
                                                                                 owl:someValuesFrom nis2onto-ops:Document
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] ;
                                    rdfs:subClassOf nis2onto-ops:EvidenceRecord ;
                                    rdfs:comment "Evidence record documenting a submitted document."@en ;
                                    rdfs:label "Document Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#EventAnalysisAndClassification
nis2onto-ops:EventAnalysisAndClassification rdf:type owl:Class ;
                                            rdfs:subClassOf nis2onto-ops:ControlTheme ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty nis2onto-ops:governedBy ;
                                                              owl:someValuesFrom nis2onto:Art21Par2-b-Entity
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty nis2onto-ops:relatedToENISATechnicalGuideSection ;
                                                              owl:hasValue "3.4"
                                                            ] ;
                                            rdfs:comment "Control theme covering the assessment of suspicious events to determine whether they constitute incidents and the classification of their nature and severity."@en ;
                                            rdfs:label "Event Analysis and Classification"@en .


###  https://w3id.org/nis2onto-ops#EventEvidenceRecord
nis2onto-ops:EventEvidenceRecord rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( nis2onto-ops:EvidenceRecord
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty nis2onto-ops:recordsEvent ;
                                                                              owl:someValuesFrom nis2onto:Event
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:subClassOf nis2onto-ops:EvidenceRecord ;
                                 rdfs:comment "Evidence record documenting the occurrence of an event."@en ;
                                 rdfs:label "Event Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#EvidenceRecord
nis2onto-ops:EvidenceRecord rdf:type owl:Class ;
                            rdfs:subClassOf [ rdf:type owl:Restriction ;
                                              owl:onProperty nis2onto-ops:producedBy ;
                                              owl:someValuesFrom [ rdf:type owl:Class ;
                                                                   owl:unionOf ( nis2onto:Assessment
                                                                                 nis2onto-ops:SoftwareApplication
                                                                                 nis2onto-ops:SoftwareModule
                                                                               )
                                                                 ]
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty nis2onto-ops:hasID ;
                                              owl:someValuesFrom xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty nis2onto-ops:hasTimestamp ;
                                              owl:someValuesFrom xsd:dateTime
                                            ] ;
                            rdfs:comment "Record capturing evidence collected during security monitoring, detection, or assessment."@en ;
                            rdfs:label "Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#FileFormat
nis2onto-ops:FileFormat rdf:type owl:Class ;
                        rdfs:subClassOf nis2onto:NIS2GeneralOntologicalEntity ;
                        rdfs:comment "Classification of file's type or encoding."@en ;
                        rdfs:label "File Format"@en .


###  https://w3id.org/nis2onto-ops#HashAlgorithm
nis2onto-ops:HashAlgorithm rdf:type owl:Class ;
                           rdfs:subClassOf nis2onto-ops:HashComponent ;
                           rdfs:comment "Cryptographic algorithm used to compute a hash digest."@en ;
                           rdfs:label "Hash Algorithm"@en .


###  https://w3id.org/nis2onto-ops#HashComponent
nis2onto-ops:HashComponent rdf:type owl:Class ;
                           rdfs:subClassOf nis2onto:NIS2GeneralOntologicalEntity ;
                           rdfs:comment "Component involved in producing or representing a cryptographic hash."@en ;
                           rdfs:label "Hash Component"@en .


###  https://w3id.org/nis2onto-ops#HashDigest
nis2onto-ops:HashDigest rdf:type owl:Class ;
                        rdfs:subClassOf nis2onto-ops:HashComponent ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty nis2onto-ops:hashedUsing ;
                                          owl:someValuesFrom nis2onto-ops:HashAlgorithm
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty nis2onto-ops:hasHashValue ;
                                          owl:someValuesFrom xsd:string
                                        ] ;
                        rdfs:comment "Fixed-length value produced by applying a hash algorithm to data."@en ;
                        rdfs:label "Hash Digest"@en .


###  https://w3id.org/nis2onto-ops#IOCMatching
nis2onto-ops:IOCMatching rdf:type owl:Class ;
                         rdfs:subClassOf nis2onto-ops:RuleBasedAssessment ;
                         rdfs:comment "Rule-based assessment that matches observed data against known Indicators of Compromise."@en ;
                         rdfs:label "IOC Matching"@en .


###  https://w3id.org/nis2onto-ops#ITAsset
nis2onto-ops:ITAsset rdf:type owl:Class ;
                     rdfs:subClassOf nis2onto-ops:Asset ;
                     rdfs:comment "Information Technology asset such as a workstation, server, cloud instance, or software application."@en ;
                     rdfs:label "IT Asset"@en .


###  https://w3id.org/nis2onto-ops#IncidentDetectionAndMonitoring
nis2onto-ops:IncidentDetectionAndMonitoring rdf:type owl:Class ;
                                            rdfs:subClassOf nis2onto-ops:ControlTheme ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty nis2onto-ops:governedBy ;
                                                              owl:someValuesFrom nis2onto:Art21Par2-b-Entity
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty nis2onto-ops:relatedToENISATechnicalGuideSection ;
                                                              owl:hasValue "3.2"
                                                            ] ;
                                            rdfs:comment "Control theme covering the monitoring and logging of network and information systems to detect events that could constitute incidents."@en ;
                                            rdfs:label "Incident Detection and Monitoring"@en .


###  https://w3id.org/nis2onto-ops#IncidentResponseProcedure
nis2onto-ops:IncidentResponseProcedure rdf:type owl:Class ;
                                       rdfs:subClassOf nis2onto-ops:ControlTheme ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty nis2onto-ops:governedBy ;
                                                         owl:someValuesFrom nis2onto:Art21Par2-b-Entity
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty nis2onto-ops:relatedToENISATechnicalGuideSection ;
                                                         owl:hasValue "3.5"
                                                       ] ;
                                       rdfs:comment "Control theme covering the containment, eradication, and recovery procedures used to respond to incidents."@en ;
                                       rdfs:label "Incident Response Procedure"@en .


###  https://w3id.org/nis2onto-ops#InjectionAttack
nis2onto-ops:InjectionAttack rdf:type owl:Class ;
                             rdfs:subClassOf nis2onto-ops:AssetAttack ;
                             rdfs:comment "Attack that injects malicious, falsified, or unauthorized data into an asset or communication channel."@en ;
                             rdfs:label "Injection Attack"@en .


###  https://w3id.org/nis2onto-ops#IntegrityVerification
nis2onto-ops:IntegrityVerification rdf:type owl:Class ;
                                   rdfs:subClassOf nis2onto:Assessment ;
                                   rdfs:comment "Assessment method that confirms data or a component has not been tampered with."@en ;
                                   rdfs:label "Integrity Verification"@en .


###  https://w3id.org/nis2onto-ops#Ledger
nis2onto-ops:Ledger rdf:type owl:Class ;
                    rdfs:subClassOf nis2onto-ops:SoftwareApplication ;
                    rdfs:comment "Software application, such as a blockchain, that stores records for integrity and traceability."@en ;
                    rdfs:label "Ledger"@en .


###  https://w3id.org/nis2onto-ops#LedgerAttestedEvidenceRecord
nis2onto-ops:LedgerAttestedEvidenceRecord rdf:type owl:Class ;
                                          owl:equivalentClass [ owl:intersectionOf ( nis2onto-ops:EvidenceRecord
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty nis2onto-ops:hasHashDigest ;
                                                                                       owl:someValuesFrom nis2onto-ops:HashDigest
                                                                                     ]
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty nis2onto-ops:recordedOnLedger ;
                                                                                       owl:someValuesFrom nis2onto-ops:Ledger
                                                                                     ]
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty nis2onto-ops:hasBlockchainTxID ;
                                                                                       owl:someValuesFrom xsd:string
                                                                                     ]
                                                                                   ) ;
                                                                rdf:type owl:Class
                                                              ] ;
                                          rdfs:subClassOf nis2onto-ops:EvidenceRecord ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty nis2onto-ops:supportsControlTheme ;
                                                            owl:hasValue nis2onto-ops:ledger_evidence_recording
                                                          ] ;
                                          rdfs:comment "Evidence record whose integrity is attested by a hash digest anchored to a ledger via a blockchain transaction ID."@en ;
                                          rdfs:label "Ledger-Attested Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#MISP
nis2onto-ops:MISP rdf:type owl:Class ;
                  rdfs:subClassOf nis2onto:CybersecurityTool ,
                                  nis2onto-ops:CybersecuritySoftwareApplication ;
                  rdfs:comment "MISP (Malware Information Sharing Platform or Threat Sharing) is an open-source Threat Intelligence Platform (TIP) to store, share, and analyze Indicators of Compromise (IoCs)."@en ;
                  rdfs:label "MISP"@en .


###  https://w3id.org/nis2onto-ops#ManualAssessment
nis2onto-ops:ManualAssessment rdf:type owl:Class ;
                              rdfs:subClassOf nis2onto:Assessment ;
                              rdfs:comment "Assessment method carried out through direct human analysis rather than automated tooling."@en ;
                              rdfs:label "Manual Assessment"@en .


###  https://w3id.org/nis2onto-ops#MonitoringEvidenceRecord
nis2onto-ops:MonitoringEvidenceRecord rdf:type owl:Class ;
                                      owl:equivalentClass [ owl:intersectionOf ( nis2onto-ops:EvidenceRecord
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty nis2onto-ops:recordsMonitoringOutcome ;
                                                                                   owl:someValuesFrom nis2onto-ops:MonitoringOutcome
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ] ;
                                      rdfs:subClassOf nis2onto-ops:EvidenceRecord ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty nis2onto-ops:supportsControlTheme ;
                                                        owl:hasValue nis2onto-ops:component_integrity_evaluation
                                                      ] ;
                                      rdfs:comment "Evidence record documenting a monitoring outcome."@en ;
                                      rdfs:label "Monitoring Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#MonitoringOutcome
nis2onto-ops:MonitoringOutcome rdf:type owl:Class ;
                               rdfs:subClassOf nis2onto-ops:RiskRating ;
                               rdfs:comment "Result classification of a monitoring or detection check."@en ;
                               rdfs:label "Monitoring Outcome"@en .


###  https://w3id.org/nis2onto-ops#NetworkAsset
nis2onto-ops:NetworkAsset rdf:type owl:Class ;
                          rdfs:subClassOf nis2onto-ops:ITAsset ;
                          rdfs:comment "Network asset such as a router, firewall, switch, or communication channel."@en ;
                          rdfs:label "Network Asset"@en .


###  https://w3id.org/nis2onto-ops#OTAsset
nis2onto-ops:OTAsset rdf:type owl:Class ;
                     rdfs:subClassOf nis2onto-ops:Asset ;
                     rdfs:comment "Operational Technology asset such as a sensor, embedded controller, or industrial system."@en ;
                     rdfs:label "OT Asset"@en .


###  https://w3id.org/nis2onto-ops#PlaybookExecutionEvidenceRecord
nis2onto-ops:PlaybookExecutionEvidenceRecord rdf:type owl:Class ;
                                             owl:equivalentClass [ owl:intersectionOf ( nis2onto-ops:EvidenceRecord
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty nis2onto-ops:recordsExecutionOf ;
                                                                                          owl:someValuesFrom nis2onto-ops:DCOPlaybook
                                                                                        ]
                                                                                      ) ;
                                                                   rdf:type owl:Class
                                                                 ] ;
                                             rdfs:subClassOf nis2onto-ops:EvidenceRecord ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty nis2onto-ops:supportsControlTheme ;
                                                               owl:hasValue nis2onto-ops:dco_playbook_incident_response
                                                             ] ;
                                             rdfs:comment "Evidence record documenting the execution of a DCO playbook."@en ;
                                             rdfs:label "Playbook Execution Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#PolicyBasedScan
nis2onto-ops:PolicyBasedScan rdf:type owl:Class ;
                             rdfs:subClassOf nis2onto-ops:RuleBasedAssessment ;
                             rdfs:comment "Rule-based assessment that checks compliance against a defined security policy."@en ;
                             rdfs:label "Policy-Based Scan"@en .


###  https://w3id.org/nis2onto-ops#PostureScore
nis2onto-ops:PostureScore rdf:type owl:Class ;
                          rdfs:subClassOf nis2onto-ops:RiskRating ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty nis2onto-ops:hasScoreGrade ;
                                            owl:someValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty nis2onto-ops:hasScoreValue ;
                                            owl:someValuesFrom xsd:float
                                          ] ;
                          rdfs:comment "Quantified measure of an entity's overall security posture."@en ;
                          rdfs:label "Posture Score"@en .


###  https://w3id.org/nis2onto-ops#PostureScoreEvidenceRecord
nis2onto-ops:PostureScoreEvidenceRecord rdf:type owl:Class ;
                                        owl:equivalentClass [ owl:intersectionOf ( nis2onto-ops:EvidenceRecord
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty nis2onto-ops:hasPostureScore ;
                                                                                     owl:someValuesFrom nis2onto-ops:PostureScore
                                                                                   ]
                                                                                 ) ;
                                                              rdf:type owl:Class
                                                            ] ;
                                        rdfs:subClassOf nis2onto-ops:EvidenceRecord ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty nis2onto-ops:supportsControlTheme ;
                                                          owl:hasValue nis2onto-ops:configuration_auditing
                                                        ] ;
                                        rdfs:comment "Evidence record documenting a posture score."@en ;
                                        rdfs:label "Posture Score Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#RemediationScore
nis2onto-ops:RemediationScore rdf:type owl:Class ;
                              rdfs:subClassOf nis2onto-ops:RiskRating ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty nis2onto-ops:hasScoreValue ;
                                                owl:someValuesFrom xsd:float
                                              ] ;
                              rdfs:comment "Composite score for remediation prioritization."@en ;
                              rdfs:label "Remediation Score"@en .


###  https://w3id.org/nis2onto-ops#RiskRating
nis2onto-ops:RiskRating rdf:type owl:Class ;
                        rdfs:subClassOf nis2onto:RiskAssessment ;
                        rdfs:comment "Classification used to rate risk, such as severity, criticality, posture, or monitoring outcome."@en ;
                        rdfs:label "Risk Rating"@en .


###  https://w3id.org/nis2onto-ops#RuleBasedAssessment
nis2onto-ops:RuleBasedAssessment rdf:type owl:Class ;
                                 rdfs:subClassOf nis2onto:Assessment ;
                                 rdfs:comment "Assessment method that applies predefined rules, policies, or signatures to detect conditions."@en ;
                                 rdfs:label "Rule-Based Assessment"@en .


###  https://w3id.org/nis2onto-ops#SUMOSimulator
nis2onto-ops:SUMOSimulator rdf:type owl:Class ;
                           rdfs:subClassOf nis2onto-ops:CAVSimulator ;
                           rdfs:comment "SUMO (Simulation of Urban MObility) traffic simulator."@en ;
                           rdfs:label "SUMO Simulator"@en .


###  https://w3id.org/nis2onto-ops#SecurityCatalogReference
nis2onto-ops:SecurityCatalogReference rdf:type owl:Class ;
                                      rdfs:comment "Reference to an entry in an external security catalog or knowledge base, such as CVE or CWE."@en ;
                                      rdfs:label "Security Catalog Reference"@en .


###  https://w3id.org/nis2onto-ops#SecurityPostureAndControlEffectiveness
nis2onto-ops:SecurityPostureAndControlEffectiveness rdf:type owl:Class ;
                                                    rdfs:subClassOf nis2onto-ops:ControlTheme ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty nis2onto-ops:governedBy ;
                                                                      owl:someValuesFrom nis2onto:Art21Par2-f-Entity
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty nis2onto-ops:relatedToENISATechnicalGuideSection ;
                                                                      owl:hasValue "7"
                                                                    ] ;
                                                    rdfs:comment "Control theme covering the policies and procedures used to assess the effectiveness of implemented cybersecurity risk-management measures."@en ;
                                                    rdfs:label "Security Posture and Control Effectiveness"@en .


###  https://w3id.org/nis2onto-ops#Severity
nis2onto-ops:Severity rdf:type owl:Class ;
                      rdfs:subClassOf nis2onto-ops:RiskRating ;
                      rdfs:comment "Classification of how serious a vulnerability, weakness, or incident is."@en ;
                      rdfs:label "Severity"@en .


###  https://w3id.org/nis2onto-ops#SignatureMatching
nis2onto-ops:SignatureMatching rdf:type owl:Class ;
                               rdfs:subClassOf nis2onto-ops:RuleBasedAssessment ;
                               rdfs:comment "Rule-based assessment that matches observed data against known malicious signatures."@en ;
                               rdfs:label "Signature Matching"@en .


###  https://w3id.org/nis2onto-ops#Snyk
nis2onto-ops:Snyk rdf:type owl:Class ;
                  rdfs:subClassOf nis2onto:CybersecurityTool ,
                                  nis2onto-ops:CybersecuritySoftwareApplication ;
                  rdfs:comment "Snyk is a software security platform that scans source code, open-source dependencies, containers, and infrastructure configurations to find and automatically fix security flaws."@en ;
                  rdfs:label "Snyk"@en .


###  https://w3id.org/nis2onto-ops#SoftwareApplication
nis2onto-ops:SoftwareApplication rdf:type owl:Class ;
                                 rdfs:subClassOf nis2onto-ops:SoftwareAsset ;
                                 rdfs:comment "Software that is intended for end-user use."@en ;
                                 rdfs:label "Software Application"@en .


###  https://w3id.org/nis2onto-ops#SoftwareAsset
nis2onto-ops:SoftwareAsset rdf:type owl:Class ;
                           rdfs:subClassOf nis2onto-ops:ITAsset ;
                           rdfs:comment "Software-related asset."@en ;
                           rdfs:label "Software Asset"@en .


###  https://w3id.org/nis2onto-ops#SoftwareModule
nis2onto-ops:SoftwareModule rdf:type owl:Class ;
                            rdfs:subClassOf nis2onto-ops:SoftwareAsset ;
                            rdfs:comment "Software unit responsible for a specific function."@en ;
                            rdfs:label "Software Module"@en .


###  https://w3id.org/nis2onto-ops#StreamPatternMatching
nis2onto-ops:StreamPatternMatching rdf:type owl:Class ;
                                   rdfs:subClassOf nis2onto-ops:RuleBasedAssessment ;
                                   rdfs:comment "Rule-based assessment that matches patterns within a continuous data stream."@en ;
                                   rdfs:label "Stream Pattern Matching"@en .


###  https://w3id.org/nis2onto-ops#SupplyChainSecurity
nis2onto-ops:SupplyChainSecurity rdf:type owl:Class ;
                                 rdfs:subClassOf nis2onto-ops:ControlTheme ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty nis2onto-ops:governedBy ;
                                                   owl:someValuesFrom nis2onto:Art21Par2-d-Entity
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty nis2onto-ops:relatedToENISATechnicalGuideSection ;
                                                   owl:hasValue "5.1"
                                                 ] ;
                                 rdfs:comment "Control theme covering the identification and management of risks arising from suppliers, service providers, and third-party software components in the network and information systems supply chain."@en ;
                                 rdfs:label "Supply Chain Security"@en .


###  https://w3id.org/nis2onto-ops#Suricata
nis2onto-ops:Suricata rdf:type owl:Class ;
                      rdfs:subClassOf nis2onto:CybersecurityTool ,
                                      nis2onto-ops:CybersecuritySoftwareApplication ;
                      rdfs:comment "Suricata is an open-source Network Intrusion Detection System (NIDS), Intrusion Prevention System (IPS), and Network Security Monitoring (NSM) engine that performs deep packet inspection and watches network traffic for malicious patterns, policy violations, and suspicious anomalies."@en ;
                      rdfs:label "Suricata"@en .


###  https://w3id.org/nis2onto-ops#ThreatEvidenceRecord
nis2onto-ops:ThreatEvidenceRecord rdf:type owl:Class ;
                                  owl:equivalentClass [ owl:intersectionOf ( nis2onto-ops:EvidenceRecord
                                                                             [ rdf:type owl:Class ;
                                                                               owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty nis2onto-ops:recordsAttackTactic ;
                                                                                               owl:someValuesFrom nis2onto-ops:AttackTactic
                                                                                             ]
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty nis2onto-ops:recordsAttackTechnique ;
                                                                                               owl:someValuesFrom nis2onto-ops:AttackTechnique
                                                                                             ]
                                                                                           )
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] ;
                                  rdfs:subClassOf nis2onto-ops:CTIEnrichedEvidenceRecord ;
                                  rdfs:comment "Evidence record documenting an attack tactic or technique from the MITRE ATT&CK knowledge base."@en ;
                                  rdfs:label "Threat Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#VulnerabilityEvidenceRecord
nis2onto-ops:VulnerabilityEvidenceRecord rdf:type owl:Class ;
                                         owl:equivalentClass [ owl:intersectionOf ( nis2onto-ops:EvidenceRecord
                                                                                    [ rdf:type owl:Class ;
                                                                                      owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty nis2onto-ops:recordsVulnerability ;
                                                                                                      owl:someValuesFrom nis2onto-ops:CVE
                                                                                                    ]
                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty nis2onto-ops:recordsWeakness ;
                                                                                                      owl:someValuesFrom nis2onto-ops:CWE
                                                                                                    ]
                                                                                                  )
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ;
                                         rdfs:subClassOf nis2onto-ops:CTIEnrichedEvidenceRecord ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty nis2onto-ops:supportsControlTheme ;
                                                           owl:hasValue nis2onto-ops:cve_cwe_disclosure
                                                         ] ;
                                         rdfs:comment "Evidence record documenting a vulnerability/weakness from a CVE/CWE."@en ;
                                         rdfs:label "Vulnerability Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#VulnerabilityHandlingAndDisclosure
nis2onto-ops:VulnerabilityHandlingAndDisclosure rdf:type owl:Class ;
                                                rdfs:subClassOf nis2onto-ops:ControlTheme ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty nis2onto-ops:governedBy ;
                                                                  owl:someValuesFrom nis2onto:Art21Par2-e-Entity
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty nis2onto-ops:relatedToENISATechnicalGuideSection ;
                                                                  owl:hasValue "6.10"
                                                                ] ;
                                                rdfs:comment "Control theme covering the identification, handling, and coordinated disclosure of vulnerabilities affecting network and information systems."@en ;
                                                rdfs:label "Vulnerability Handling and Disclosure"@en .


###  https://w3id.org/nis2onto-ops#Wazuh
nis2onto-ops:Wazuh rdf:type owl:Class ;
                   rdfs:subClassOf nis2onto:CybersecurityTool ,
                                   nis2onto-ops:CybersecuritySoftwareApplication ;
                   rdfs:comment "Wazuh is an open-source, enterprise-grade security monitoring platform that uses agents to collect, analyze, and correlate logs in real-time, offering file integrity monitoring, vulnerability detection, and incident response."@en ;
                   rdfs:label "Wazuh"@en .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/nis2onto-ops#CROSSCORE
nis2onto-ops:CROSSCORE rdf:type owl:NamedIndividual ,
                                nis2onto-ops:CybersecuritySoftwareModule ;
                       nis2onto-ops:hasCriticality nis2onto-ops:n_a ;
                       nis2onto-ops:hasID "CROSSCORE" ;
                       rdfs:comment "CYberSynchrony module that facilitates secure, cross-border cooperation during cyber incidents. Blockchain technology ensures data integrity, enabling reliable information sharing among MS."@en ;
                       rdfs:label "CROSSCORE"@en .


###  https://w3id.org/nis2onto-ops#CYBERGOPLUS
nis2onto-ops:CYBERGOPLUS rdf:type owl:NamedIndividual ,
                                  nis2onto-ops:CybersecuritySoftwareModule ;
                         nis2onto-ops:hasComponent nis2onto-ops:CYBERGOPLUS-Snyk ;
                         nis2onto-ops:hasCriticality nis2onto-ops:n_a ;
                         nis2onto-ops:hasID "CYBERGOPLUS" ;
                         rdfs:comment "CYberSynchrony module that supports the implementation of robust cybersecurity policies and standards, ensuring consistent practices and regulatory compliance across sectors."@en ;
                         rdfs:label "CYBERGOPLUS"@en .


###  https://w3id.org/nis2onto-ops#CYBERGOPLUS-Snyk
nis2onto-ops:CYBERGOPLUS-Snyk rdf:type owl:NamedIndividual ,
                                       nis2onto-ops:Snyk ;
                              nis2onto-ops:hasCriticality nis2onto-ops:n_a ;
                              nis2onto-ops:hasID "CYBERGOPLUS-Snyk" ;
                              rdfs:comment "Snyk instance deployed as a component of the CYBERGOPLUS cybersecurity module."@en ;
                              rdfs:label "CYBERGOPLUS Snyk"@en .


###  https://w3id.org/nis2onto-ops#CYBERRA
nis2onto-ops:CYBERRA rdf:type owl:NamedIndividual ,
                              nis2onto-ops:CybersecuritySoftwareModule ;
                     nis2onto-ops:hasComponent nis2onto-ops:CYBERRA-MISP ;
                     nis2onto-ops:hasCriticality nis2onto-ops:n_a ;
                     nis2onto-ops:hasID "CYBERRA" ;
                     rdfs:comment "CYberSynchrony module that focuses on real-time threat intelligence and tailored risk analysis for member states, ensuring reliable assessments through secure forensic methods."@en ;
                     rdfs:label "CYBERRA"@en .


###  https://w3id.org/nis2onto-ops#CYBERRA-MISP
nis2onto-ops:CYBERRA-MISP rdf:type owl:NamedIndividual ,
                                   nis2onto-ops:MISP ;
                          nis2onto-ops:hasCriticality nis2onto-ops:n_a ;
                          nis2onto-ops:hasID "CYBERRA-MISP" ;
                          rdfs:comment "MISP instance deployed as a component of the CYBERRA cybersecurity module."@en ;
                          rdfs:label "CYBERRA MISP"@en .


###  https://w3id.org/nis2onto-ops#CYBERWISE
nis2onto-ops:CYBERWISE rdf:type owl:NamedIndividual ,
                                nis2onto-ops:CybersecuritySoftwareModule ;
                       nis2onto-ops:hasCriticality nis2onto-ops:n_a ;
                       nis2onto-ops:hasID "CYBERWISE" ;
                       rdfs:comment "CYberSynchrony module that promotes cybersecurity awareness through engaging, educational tools, fostering a culture of cybersecurity across society."@en ;
                       rdfs:label "CYBERWISE"@en .


###  https://w3id.org/nis2onto-ops#CYBRITE
nis2onto-ops:CYBRITE rdf:type owl:NamedIndividual ,
                              nis2onto-ops:CybersecuritySoftwareModule ;
                     nis2onto-ops:hasComponent nis2onto-ops:CYBRITE-Suricata ,
                                               nis2onto-ops:CYBRITE-Wazuh ;
                     nis2onto-ops:hasCriticality nis2onto-ops:n_a ;
                     nis2onto-ops:hasID "CYBRITE" ;
                     rdfs:comment "CYberSynchrony module that provides continuous monitoring to detect threats early. Advanced analytics support proactive risk management, minimizing incident impact."@en ;
                     rdfs:label "CYBRITE"@en .


###  https://w3id.org/nis2onto-ops#CYBRITE-Suricata
nis2onto-ops:CYBRITE-Suricata rdf:type owl:NamedIndividual ,
                                       nis2onto-ops:Suricata ;
                              nis2onto-ops:hasCriticality nis2onto-ops:n_a ;
                              nis2onto-ops:hasID "CYBRITE-Suricata" ;
                              rdfs:comment "Suricata instance deployed as a component of the CYBRITE cybersecurity module."@en ;
                              rdfs:label "CYBRITE Suricata"@en .


###  https://w3id.org/nis2onto-ops#CYBRITE-Wazuh
nis2onto-ops:CYBRITE-Wazuh rdf:type owl:NamedIndividual ,
                                    nis2onto-ops:Wazuh ;
                           nis2onto-ops:hasCriticality nis2onto-ops:n_a ;
                           nis2onto-ops:hasID "CYBRITE-Wazuh" ;
                           rdfs:comment "Wazuh instance deployed as a component of the CYBRITE cybersecurity module."@en ;
                           rdfs:label "CYBRITE Wazuh"@en .


###  https://w3id.org/nis2onto-ops#CYRESCUE
nis2onto-ops:CYRESCUE rdf:type owl:NamedIndividual ,
                               nis2onto-ops:CybersecuritySoftwareModule ;
                      nis2onto-ops:hasCriticality nis2onto-ops:n_a ;
                      nis2onto-ops:hasID "CYRESCUE" ;
                      rdfs:comment "CYberSynchrony module that enhances resilience by identifying vulnerabilities in critical systems and streamlining incident response. Automated tools and secure digital vaults protect systems and data, enabling rapid response to threats."@en ;
                      rdfs:label "CYRESCUE"@en .


###  https://w3id.org/nis2onto-ops#adversarial_perturbation_detection
nis2onto-ops:adversarial_perturbation_detection rdf:type owl:NamedIndividual ,
                                                         nis2onto-ops:AnomalyDetection ;
                                                rdfs:comment "Identifies adversarial perturbations crafted to fool a perception AI model."@en ;
                                                rdfs:label "Adversarial Perturbation Detection"@en .


