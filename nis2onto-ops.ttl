nis2onto-ops:content_signature_match rdf:type owl:NamedIndividual ,
                                              nis2onto-ops:SignatureMatching ;
                                     rdfs:comment "Compares content against known malicious signatures."@en ;
                                     rdfs:label "Content Signature Match"@en .


###  https://w3id.org/nis2onto-ops#credential_login_check
nis2onto-ops:credential_login_check rdf:type owl:NamedIndividual ,
                                             nis2onto-ops:AuthenticationCheck ;
                                    rdfs:comment "Verifies login credentials such as username and password."@en ;
                                    rdfs:label "Credential Login Check"@en .


###  https://w3id.org/nis2onto-ops#critical_criticality
nis2onto-ops:critical_criticality rdf:type owl:NamedIndividual ,
                                           nis2onto-ops:Criticality ;
                                  rdfs:comment "Criticality level indicating the asset is essential and its failure would have severe impact."@en ;
                                  rdfs:label "Critical"@en .


###  https://w3id.org/nis2onto-ops#critical_severity
nis2onto-ops:critical_severity rdf:type owl:NamedIndividual ,
                                        nis2onto-ops:Severity ;
                               rdfs:comment "Severity level indicating the highest degree of seriousness, requiring immediate action."@en ;
                               rdfs:label "Critical"@en .


###  https://w3id.org/nis2onto-ops#csv_format
nis2onto-ops:csv_format rdf:type owl:NamedIndividual ,
                                 nis2onto-ops:FileFormat ;
                        rdfs:comment "Comma-Separated Values format."@en ;
                        rdfs:label "CSV"@en .


###  https://w3id.org/nis2onto-ops#cti_enrichment
nis2onto-ops:cti_enrichment rdf:type owl:NamedIndividual ,
                                     nis2onto-ops:EventAnalysisAndClassification ;
                            rdfs:comment "Incident-context enrichment via external CTI (Cyber Threat Intelligence), e.g., MISP IoC (Indicator of Compromise)."@en ;
                            rdfs:label "CTI Enrichment"@en .


###  https://w3id.org/nis2onto-ops#cve_cwe_disclosure
nis2onto-ops:cve_cwe_disclosure rdf:type owl:NamedIndividual ,
                                         nis2onto-ops:VulnerabilityHandlingAndDisclosure ;
                                rdfs:comment "Reporting and disclosure of identified CVEs and their underlying CWEs."@en ;
                                rdfs:label "CVE/CWE Disclosure"@en .


###  https://w3id.org/nis2onto-ops#cvgl_auth_attempt
nis2onto-ops:cvgl_auth_attempt rdf:type owl:NamedIndividual ,
                                        nis2onto-ops:CAVCVGLEvent ;
                               rdfs:comment "Event representing an authentication or access attempt against the CVGL correction service."@en ;
                               rdfs:label "CVGL Authentication Attempt"@en .


###  https://w3id.org/nis2onto-ops#cvgl_availability_monitoring
nis2onto-ops:cvgl_availability_monitoring rdf:type owl:NamedIndividual ,
                                                   nis2onto-ops:AnomalyDetection ,
                                                   nis2onto-ops:IntegrityVerification ;
                                          rdfs:comment "Monitors the CVGL correction service's request rate, response latency, error rate and resource use against its normal operating envelope, including whether it answered at all."@en ;
                                          rdfs:label "CVGL Availability Monitoring"@en .


###  https://w3id.org/nis2onto-ops#cvgl_config_data_poisoning
nis2onto-ops:cvgl_config_data_poisoning rdf:type owl:NamedIndividual ,
                                                 nis2onto-ops:CAVCVGLAttack ;
                                        rdfs:comment "Attack that poisons the cached satellite reference tiles the CVGL service matches ground imagery against."@en ;
                                        rdfs:label "CVGL Configuration Data Poisoning"@en .


###  https://w3id.org/nis2onto-ops#cvgl_config_mismatch
nis2onto-ops:cvgl_config_mismatch rdf:type owl:NamedIndividual ,
                                           nis2onto-ops:CAVCVGLEvent ;
                                  rdfs:comment "Event in which the CVGL service's configuration files or stored satellite reference tiles no longer match their recorded baseline fingerprint."@en ;
                                  rdfs:label "CVGL Configuration Mismatch"@en .


###  https://w3id.org/nis2onto-ops#cvgl_config_tampering
nis2onto-ops:cvgl_config_tampering rdf:type owl:NamedIndividual ,
                                            nis2onto-ops:CAVCVGLAttack ;
                                   rdfs:comment "Attack that modifies the CVGL service's configuration so that corrections are computed differently."@en ;
                                   rdfs:label "CVGL Configuration Tampering"@en .


###  https://w3id.org/nis2onto-ops#cvgl_correction_out_of_envelope
nis2onto-ops:cvgl_correction_out_of_envelope rdf:type owl:NamedIndividual ,
                                                      nis2onto-ops:CAVCVGLEvent ;
                                             rdfs:comment "Event in which a returned CVGL correction falls outside the residual envelope the service was validated for, relative to the raw GNSS fix and the dead-reckoning estimate."@en ;
                                             rdfs:label "CVGL Correction Out of Envelope"@en .


###  https://w3id.org/nis2onto-ops#cvgl_correction_stale
nis2onto-ops:cvgl_correction_stale rdf:type owl:NamedIndividual ,
                                            nis2onto-ops:CAVCVGLEvent ;
                                   rdfs:comment "Event in which a CVGL correction carries an outdated timestamp, a repeated sequence number or a reused nonce, so it does not describe the vehicle's current position."@en ;
                                   rdfs:label "CVGL Correction Stale"@en .


###  https://w3id.org/nis2onto-ops#cvgl_delay_replay
nis2onto-ops:cvgl_delay_replay rdf:type owl:NamedIndividual ,
                                        nis2onto-ops:CAVCVGLAttack ;
                               rdfs:comment "Attack that replays delayed CVGL data to mislead the localization result."@en ;
                               rdfs:label "CVGL Delay Replay"@en .


###  https://w3id.org/nis2onto-ops#cvgl_delay_replay_injection
nis2onto-ops:cvgl_delay_replay_injection rdf:type owl:NamedIndividual ,
                                                  nis2onto-ops:CAVCVGLAttack ,
                                                  nis2onto-ops:InjectionAttack ;
                                         rdfs:comment "Injection attack that feeds delayed, replayed data into the CVGL service."@en ;
                                         rdfs:label "CVGL Delay Replay Injection"@en .


###  https://w3id.org/nis2onto-ops#cvgl_dos
nis2onto-ops:cvgl_dos rdf:type owl:NamedIndividual ,
                               nis2onto-ops:CAVCVGLAttack ;
                      rdfs:comment "Attack that floods the CVGL correction service or the path to it so that corrections time out for the vehicles relying on it."@en ;
                      rdfs:label "CVGL Denial of Service"@en .


###  https://w3id.org/nis2onto-ops#cvgl_integrity_check
nis2onto-ops:cvgl_integrity_check rdf:type owl:NamedIndividual ,
                                           nis2onto-ops:AnomalyDetection ,
                                           nis2onto-ops:IntegrityVerification ;
                                  rdfs:comment "Verifies the integrity of CVGL localization data."@en ;
                                  rdfs:label "CVGL Integrity Check"@en .


###  https://w3id.org/nis2onto-ops#cvgl_manipulation
nis2onto-ops:cvgl_manipulation rdf:type owl:NamedIndividual ,
                                        nis2onto-ops:CAVCVGLAttack ;
                               rdfs:comment "Attack that manipulates CVGL inputs or outputs to produce an incorrect localization."@en ;
                               rdfs:label "CVGL Manipulation"@en .


###  https://w3id.org/nis2onto-ops#cvgl_unauth
nis2onto-ops:cvgl_unauth rdf:type owl:NamedIndividual ,
                                  nis2onto-ops:CAVCVGLAttack ;
                         rdfs:comment "Attack involving unauthorized access to the CVGL correction service or its host."@en ;
                         rdfs:label "CVGL Unauthorized Access"@en .


###  https://w3id.org/nis2onto-ops#cvgl_unauth_injection
nis2onto-ops:cvgl_unauth_injection rdf:type owl:NamedIndividual ,
                                            nis2onto-ops:CAVCVGLAttack ,
                                            nis2onto-ops:InjectionAttack ;
                                   rdfs:comment "Injection attack that performs unauthorized access against the CVGL correction service."@en ;
                                   rdfs:label "CVGL Unauthorized Injection"@en .


###  https://w3id.org/nis2onto-ops#cvgl_unavailable
nis2onto-ops:cvgl_unavailable rdf:type owl:NamedIndividual ,
                                       nis2onto-ops:CAVCVGLEvent ;
                              rdfs:comment "Event in which the CVGL correction service does not answer, or answers too slowly or with too many errors for its corrections to be usable by the vehicles relying on it."@en ;
                              rdfs:label "CVGL Unavailable"@en .


###  https://w3id.org/nis2onto-ops#dco_playbook_incident_response
nis2onto-ops:dco_playbook_incident_response rdf:type owl:NamedIndividual ,
                                                     nis2onto-ops:IncidentResponseProcedure ;
                                            rdfs:comment "Incident response carried out through execution of a DCO playbook."@en ;
                                            rdfs:label "DCO Playbook Incident Response"@en .


###  https://w3id.org/nis2onto-ops#dead_reckoning_cross_validation
nis2onto-ops:dead_reckoning_cross_validation rdf:type owl:NamedIndividual ,
