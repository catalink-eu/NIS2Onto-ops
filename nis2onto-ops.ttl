@prefix : <https://w3id.org/nis2onto-ops> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix nis2onto: <http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#> .
@prefix nis2onto-ops: <https://w3id.org/nis2onto-ops#> .
@base <https://w3id.org/nis2onto-ops> .

<https://w3id.org/nis2onto-ops> rdf:type owl:Ontology ;
                                 owl:imports <http://www.unict.it/nas-inf/nis2onto/nis2onto.owl> ;
                                 rdfs:comment "NIS2Onto-ops is an operational ontology that extends NIS2Onto with the concepts needed to monitor assets, track security events, and record cybersecurity evidence in the context of NIS2 Article 21 risk-management obligations. It adds a compliance-governance layer that ties control judgements back to specific regulatory requirements, enabling automated, evidence-based classification of compliance status over time. Developed as part of the NIS2Graph project."@en ;
                                 rdfs:label "NIS2Onto-ops"@en .

#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/nis2onto-ops#achievesAttackTactic
nis2onto-ops:achievesAttackTactic rdf:type owl:ObjectProperty ;
                                  owl:inverseOf nis2onto-ops:isAchievedByAttackTechnique ;
                                  rdfs:domain nis2onto-ops:AttackTechnique ;
                                  rdfs:range nis2onto-ops:AttackTactic ;
                                  rdfs:comment "Technique that serves a MITRE ATT&CK tactic."@en ;
                                  rdfs:label "achieves attack tactic"@en .


###  https://w3id.org/nis2onto-ops#assessedByEvidenceRecord
nis2onto-ops:assessedByEvidenceRecord rdf:type owl:ObjectProperty ;
                                      rdfs:domain nis2onto-ops:Asset ;
                                      rdfs:range nis2onto-ops:EvidenceRecord ;
                                      rdfs:comment "Asset is assessed by an evidence record."@en ;
                                      rdfs:label "assessed by evidence record"@en .


###  https://w3id.org/nis2onto-ops#assessesAsset
nis2onto-ops:assessesAsset rdf:type owl:ObjectProperty ;
                           rdfs:domain nis2onto-ops:EvidenceRecord ;
                           rdfs:range nis2onto-ops:Asset ;
                           rdfs:comment "Evidence record assesses an asset."@en ;
                           rdfs:label "assesses asset"@en .


###  https://w3id.org/nis2onto-ops#causesVulnerability
nis2onto-ops:causesVulnerability rdf:type owl:ObjectProperty ;
                                 owl:inverseOf nis2onto-ops:hasCausalWeakness ;
                                 rdfs:domain nis2onto-ops:CWE ;
                                 rdfs:range nis2onto-ops:CVE ;
                                 rdfs:comment "Underlying weakness causes a vulnerability."@en ;
                                 rdfs:label "causes vulnerability"@en .


###  https://w3id.org/nis2onto-ops#communicatesWith
nis2onto-ops:communicatesWith rdf:type owl:ObjectProperty ,
                                       owl:SymmetricProperty ;
                              rdfs:domain nis2onto-ops:Asset ;
                              rdfs:range nis2onto-ops:Asset ;
                              rdfs:comment "Asset communicates with another asset."@en ;
                              rdfs:label "communicates with"@en .


###  https://w3id.org/nis2onto-ops#evidencedBy
nis2onto-ops:evidencedBy rdf:type owl:ObjectProperty ;
                         owl:inverseOf nis2onto-ops:evidences ;
                         rdfs:domain nis2onto-ops:ControlRuling ;
                         rdfs:range nis2onto-ops:EvidenceRecord ;
                         rdfs:comment "Control ruling is evidenced by an evidence record."@en ;
                         rdfs:label "evidenced by"@en .


###  https://w3id.org/nis2onto-ops#evidences
nis2onto-ops:evidences rdf:type owl:ObjectProperty ;
                       rdfs:domain nis2onto-ops:EvidenceRecord ;
                       rdfs:range nis2onto-ops:ControlRuling ;
                       rdfs:comment "Evidence record evidences a control ruling."@en ;
                       rdfs:label "evidences"@en .


###  https://w3id.org/nis2onto-ops#followedByEvent
nis2onto-ops:followedByEvent rdf:type owl:ObjectProperty ;
                             owl:inverseOf nis2onto-ops:followsEvent ;
                             rdfs:domain nis2onto:Event ;
                             rdfs:range nis2onto:Event ;
                             rdfs:comment "Event followed by another event."@en ;
                             rdfs:label "followed by event"@en .


###  https://w3id.org/nis2onto-ops#followedByEvidenceRecord
nis2onto-ops:followedByEvidenceRecord rdf:type owl:ObjectProperty ;
                                      owl:inverseOf nis2onto-ops:followsEvidenceRecord ;
                                      rdfs:domain nis2onto-ops:EvidenceRecord ;
                                      rdfs:range nis2onto-ops:EvidenceRecord ;
                                      rdfs:comment "Evidence record is followed by another record."@en ;
                                      rdfs:label "followed by evidence record"@en .


###  https://w3id.org/nis2onto-ops#followsEvent
nis2onto-ops:followsEvent rdf:type owl:ObjectProperty ;
                          rdfs:domain nis2onto:Event ;
                          rdfs:range nis2onto:Event ;
                          rdfs:comment "Event is a followup to another event."@en ;
                          rdfs:label "follows event"@en .


###  https://w3id.org/nis2onto-ops#followsEvidenceRecord
nis2onto-ops:followsEvidenceRecord rdf:type owl:ObjectProperty ;
                                   rdfs:domain nis2onto-ops:EvidenceRecord ;
                                   rdfs:range nis2onto-ops:EvidenceRecord ;
                                   rdfs:comment "Evidence record is a followup to another record."@en ;
                                   rdfs:label "follows evidence record"@en .


###  https://w3id.org/nis2onto-ops#governedBy
nis2onto-ops:governedBy rdf:type owl:ObjectProperty ;
                        rdfs:comment "Entity governed by NIS2 article."@en ;
                        rdfs:label "governed by"@en .


###  https://w3id.org/nis2onto-ops#hasCausalWeakness
nis2onto-ops:hasCausalWeakness rdf:type owl:ObjectProperty ;
                               rdfs:domain nis2onto-ops:CVE ;
                               rdfs:range nis2onto-ops:CWE ;
                               rdfs:comment "Vulnerability exists because it has a specific underlying causal weakness."@en ;
                               rdfs:label "has causal weakness"@en .


###  https://w3id.org/nis2onto-ops#hasComponent
nis2onto-ops:hasComponent rdf:type owl:ObjectProperty ;
                          owl:inverseOf nis2onto-ops:isComponentOf ;
                          rdfs:domain nis2onto-ops:Asset ;
                          rdfs:range nis2onto-ops:Asset ;
                          rdfs:comment "Asset has another asset as a component of itself."@en ;
                          rdfs:label "has component"@en .


###  https://w3id.org/nis2onto-ops#hasControlScope
nis2onto-ops:hasControlScope rdf:type owl:ObjectProperty ;
                             rdfs:domain nis2onto-ops:ControlRuling ;
                             rdfs:range nis2onto-ops:ControlScope ;
                             rdfs:comment "Control ruling evaluates a specific control scope."@en ;
                             rdfs:label "has control scope"@en .


###  https://w3id.org/nis2onto-ops#hasControlStatus
nis2onto-ops:hasControlStatus rdf:type owl:ObjectProperty ;
                              rdfs:domain nis2onto-ops:ControlRuling ;
                              rdfs:range nis2onto-ops:ControlStatus ;
                              rdfs:comment "Control ruling is assigned a control status as its outcome."@en ;
                              rdfs:label "has control status"@en .


###  https://w3id.org/nis2onto-ops#hasCriticality
nis2onto-ops:hasCriticality rdf:type owl:ObjectProperty ;
                            rdfs:domain nis2onto-ops:Asset ;
                            rdfs:range nis2onto-ops:Criticality ;
                            rdfs:comment "Asset has a criticality classification."@en ;
                            rdfs:label "has criticality"@en .


###  https://w3id.org/nis2onto-ops#hasFileFormat
nis2onto-ops:hasFileFormat rdf:type owl:ObjectProperty ;
                           rdfs:domain nis2onto-ops:Document ;
                           rdfs:range nis2onto-ops:FileFormat ;
                           rdfs:comment "Document has a file format."@en ;
                           rdfs:label "has file format"@en .


###  https://w3id.org/nis2onto-ops#hasHashDigest
nis2onto-ops:hasHashDigest rdf:type owl:ObjectProperty ;
                           rdfs:range nis2onto-ops:HashDigest ;
                           rdfs:comment "Entity was hashed and has a hash digest."@en ;
                           rdfs:label "has hash digest"@en .


###  https://w3id.org/nis2onto-ops#hasInScopeAsset
nis2onto-ops:hasInScopeAsset rdf:type owl:ObjectProperty ;
                             owl:inverseOf nis2onto-ops:isAssetInScope ;
                             rdfs:domain nis2onto-ops:ControlScope ;
                             rdfs:range nis2onto-ops:Asset ;
                             rdfs:comment "Control scope has an asset as part of its evaluation boundary."@en ;
                             rdfs:label "has in-scope asset"@en .


###  https://w3id.org/nis2onto-ops#hasInScopeControlTheme
nis2onto-ops:hasInScopeControlTheme rdf:type owl:ObjectProperty ;
                                    owl:inverseOf nis2onto-ops:isControlThemeInScope ;
                                    rdfs:domain nis2onto-ops:ControlScope ;
                                    rdfs:range nis2onto-ops:ControlTheme ;
                                    rdfs:comment "Control scope has a control theme as part of its evaluation boundary."@en ;
                                    rdfs:label "has in-scope control theme"@en .


###  https://w3id.org/nis2onto-ops#hasOwner
nis2onto-ops:hasOwner rdf:type owl:ObjectProperty ;
                      rdfs:domain nis2onto-ops:Asset ;
                      rdfs:comment "Asset is owned by an entity."@en ;
                      rdfs:label "has owner"@en .


###  https://w3id.org/nis2onto-ops#hasPostureScore
nis2onto-ops:hasPostureScore rdf:type owl:ObjectProperty ;
                             rdfs:range nis2onto-ops:PostureScore ;
                             rdfs:comment "Entity has a posture score."@en ;
                             rdfs:label "has posture score"@en .


###  https://w3id.org/nis2onto-ops#hasPreviousControlRuling
nis2onto-ops:hasPreviousControlRuling rdf:type owl:ObjectProperty ;
                                      rdfs:domain nis2onto-ops:ControlRuling ;
                                      rdfs:range nis2onto-ops:ControlRuling ;
                                      rdfs:comment "Control ruling has a previous ruling."@en ;
                                      rdfs:label "has previous control ruling"@en .


###  https://w3id.org/nis2onto-ops#hasRemediationScore
nis2onto-ops:hasRemediationScore rdf:type owl:ObjectProperty ;
                                 rdfs:domain nis2onto-ops:ControlRuling ;
                                 rdfs:range nis2onto-ops:RemediationScore ;
                                 rdfs:comment "Control ruling has a remediation score."@en ;
                                 rdfs:label "has remediation score"@en .


###  https://w3id.org/nis2onto-ops#hasSeverity
nis2onto-ops:hasSeverity rdf:type owl:ObjectProperty ;
                         rdfs:range nis2onto-ops:Severity ;
                         rdfs:comment "Entity has a severity classification."@en ;
                         rdfs:label "has severity"@en .


###  https://w3id.org/nis2onto-ops#hasSoftwareDependency
nis2onto-ops:hasSoftwareDependency rdf:type owl:ObjectProperty ;
                                   owl:inverseOf nis2onto-ops:isSoftwareDependencyOf ;
                                   rdfs:domain nis2onto-ops:SoftwareAsset ;
                                   rdfs:range nis2onto-ops:SoftwareAsset ;
                                   rdfs:comment "Software has another software as a dependency."@en ;
                                   rdfs:label "has software dependency"@en .


###  https://w3id.org/nis2onto-ops#hashedUsing
nis2onto-ops:hashedUsing rdf:type owl:ObjectProperty ;
                         rdfs:domain nis2onto-ops:HashDigest ;
                         rdfs:range nis2onto-ops:HashAlgorithm ;
                         rdfs:comment "Hash digest created using a hash algorithm."@en ;
                         rdfs:label "hashed using"@en .


###  https://w3id.org/nis2onto-ops#isAchievedByAttackTechnique
nis2onto-ops:isAchievedByAttackTechnique rdf:type owl:ObjectProperty ;
                                         rdfs:domain nis2onto-ops:AttackTactic ;
                                         rdfs:range nis2onto-ops:AttackTechnique ;
                                         rdfs:comment "Tactic that is achieved by a MITRE ATT&CK technique."@en ;
                                         rdfs:label "is achieved by attack technique"@en .


###  https://w3id.org/nis2onto-ops#isAssetInScope
nis2onto-ops:isAssetInScope rdf:type owl:ObjectProperty ;
                            rdfs:domain nis2onto-ops:Asset ;
                            rdfs:range nis2onto-ops:ControlScope ;
                            rdfs:comment "Asset is an in-scope asset of a control scope."@en ;
                            rdfs:label "is asset in scope"@en .


###  https://w3id.org/nis2onto-ops#isComponentOf
nis2onto-ops:isComponentOf rdf:type owl:ObjectProperty ;
                           rdfs:domain nis2onto-ops:Asset ;
                           rdfs:range nis2onto-ops:Asset ;
                           rdfs:comment "Asset is component of another asset."@en ;
                           rdfs:label "is component of"@en .


###  https://w3id.org/nis2onto-ops#isControlThemeInScope
nis2onto-ops:isControlThemeInScope rdf:type owl:ObjectProperty ;
                                   rdfs:domain nis2onto-ops:ControlTheme ;
                                   rdfs:range nis2onto-ops:ControlScope ;
                                   rdfs:comment "Control theme is an in-scope control theme of a control scope."@en ;
                                   rdfs:label "is control theme in scope"@en .


###  https://w3id.org/nis2onto-ops#isSoftwareDependencyOf
nis2onto-ops:isSoftwareDependencyOf rdf:type owl:ObjectProperty ;
                                    rdfs:domain nis2onto-ops:SoftwareAsset ;
                                    rdfs:range nis2onto-ops:SoftwareAsset ;
                                    rdfs:comment "Software is a dependency of another software."@en ;
                                    rdfs:label "is software dependency of"@en .


###  https://w3id.org/nis2onto-ops#owns
nis2onto-ops:owns rdf:type owl:ObjectProperty ;
                  rdfs:range nis2onto-ops:Asset ;
                  rdfs:comment "Entity owns an asset."@en ;
                  rdfs:label "owns"@en .


###  https://w3id.org/nis2onto-ops#producedBy
nis2onto-ops:producedBy rdf:type owl:ObjectProperty ;
                        owl:inverseOf nis2onto-ops:produces ;
                        rdfs:domain nis2onto-ops:EvidenceRecord ;
                        rdfs:range [ rdf:type owl:Class ;
                                     owl:unionOf ( nis2onto:Assessment
                                                   nis2onto-ops:SoftwareApplication
                                                   nis2onto-ops:SoftwareModule
                                                 )
                                   ] ;
                        rdfs:comment "Source of evidence record."@en ;
                        rdfs:label "produced by"@en .


###  https://w3id.org/nis2onto-ops#produces
nis2onto-ops:produces rdf:type owl:ObjectProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( nis2onto:Assessment
                                                  nis2onto-ops:SoftwareApplication
                                                  nis2onto-ops:SoftwareModule
                                                )
                                  ] ;
                      rdfs:range nis2onto-ops:EvidenceRecord ;
                      rdfs:comment "Source that produces an evidence record."@en ;
                      rdfs:label "produces"@en .


###  https://w3id.org/nis2onto-ops#recordedOnLedger
nis2onto-ops:recordedOnLedger rdf:type owl:ObjectProperty ;
                              rdfs:range nis2onto-ops:Ledger ;
                              rdfs:comment "Entity is recorded on a ledger for integrity."@en ;
                              rdfs:label "recorded on ledger"@en .


###  https://w3id.org/nis2onto-ops#recordsAttackTactic
nis2onto-ops:recordsAttackTactic rdf:type owl:ObjectProperty ;
                                 rdfs:domain nis2onto-ops:EvidenceRecord ;
                                 rdfs:range nis2onto-ops:AttackTactic ;
                                 rdfs:comment "Evidence record documents an attack tactic from MITRE ATT&CK knowledge base."@en ;
                                 rdfs:label "records attack tactic"@en .


###  https://w3id.org/nis2onto-ops#recordsAttackTechnique
nis2onto-ops:recordsAttackTechnique rdf:type owl:ObjectProperty ;
                                    rdfs:domain nis2onto-ops:EvidenceRecord ;
                                    rdfs:range nis2onto-ops:AttackTechnique ;
                                    rdfs:comment "Evidence record documents an attack technique from MITRE ATT&CK knowledge base."@en ;
                                    rdfs:label "records attack technique"@en .


###  https://w3id.org/nis2onto-ops#recordsDocument
nis2onto-ops:recordsDocument rdf:type owl:ObjectProperty ;
                             rdfs:domain nis2onto-ops:EvidenceRecord ;
                             rdfs:range nis2onto-ops:Document ;
                             rdfs:comment "Evidence record documents a submitted document."@en ;
                             rdfs:label "records document"@en .


###  https://w3id.org/nis2onto-ops#recordsEvent
nis2onto-ops:recordsEvent rdf:type owl:ObjectProperty ;
                          rdfs:domain nis2onto-ops:EvidenceRecord ;
                          rdfs:range nis2onto:Event ;
                          rdfs:comment "Evidence record documents an event."@en ;
                          rdfs:label "records event"@en .


###  https://w3id.org/nis2onto-ops#recordsExecutionOf
nis2onto-ops:recordsExecutionOf rdf:type owl:ObjectProperty ;
                                rdfs:domain nis2onto-ops:EvidenceRecord ;
                                rdfs:range nis2onto-ops:DCOPlaybook ;
                                rdfs:comment "Evidence record documents an execution of a DCO playbook."@en ;
                                rdfs:label "records execution of"@en .


###  https://w3id.org/nis2onto-ops#recordsMonitoringOutcome
nis2onto-ops:recordsMonitoringOutcome rdf:type owl:ObjectProperty ;
                                      rdfs:domain nis2onto-ops:EvidenceRecord ;
                                      rdfs:range nis2onto-ops:MonitoringOutcome ;
                                      rdfs:comment "Evidence record documents a monitoring outcome."@en ;
                                      rdfs:label "records monitoring outcome"@en .


###  https://w3id.org/nis2onto-ops#recordsVulnerability
nis2onto-ops:recordsVulnerability rdf:type owl:ObjectProperty ;
                                  rdfs:domain nis2onto-ops:EvidenceRecord ;
                                  rdfs:range nis2onto-ops:CVE ;
                                  rdfs:comment "Evidence record documents a vulnerability from CVE."@en ;
                                  rdfs:label "records vulnerability"@en .


###  https://w3id.org/nis2onto-ops#recordsWeakness
nis2onto-ops:recordsWeakness rdf:type owl:ObjectProperty ;
                             rdfs:domain nis2onto-ops:EvidenceRecord ;
                             rdfs:range nis2onto-ops:CWE ;
                             rdfs:comment "Evidence record documents a weakness from CWE."@en ;
                             rdfs:label "records weakness"@en .


###  https://w3id.org/nis2onto-ops#relatedToAttackTactic
nis2onto-ops:relatedToAttackTactic rdf:type owl:ObjectProperty ;
                                   rdfs:domain nis2onto-ops:Attack ;
                                   rdfs:range nis2onto-ops:AttackTactic ;
                                   rdfs:comment "Attack is related to an attack tactic from MITRE ATT&CK knowledge base."@en ;
                                   rdfs:label "related to attack tactic"@en .


###  https://w3id.org/nis2onto-ops#relatedToAttackTechnique
nis2onto-ops:relatedToAttackTechnique rdf:type owl:ObjectProperty ;
                                      rdfs:domain nis2onto-ops:Attack ;
                                      rdfs:range nis2onto-ops:AttackTechnique ;
                                      rdfs:comment "Attack is related to an attack technique from MITRE ATT&CK knowledge base."@en ;
                                      rdfs:label "related to attack technique"@en .


###  https://w3id.org/nis2onto-ops#simulatedOn
nis2onto-ops:simulatedOn rdf:type owl:ObjectProperty ;
                         owl:inverseOf nis2onto-ops:simulates ;
                         rdfs:domain nis2onto-ops:Asset ;
                         rdfs:range nis2onto-ops:SoftwareApplication ;
                         rdfs:comment "Asset can be simulated on a software application."@en ;
                         rdfs:label "simulated on"@en .


###  https://w3id.org/nis2onto-ops#simulates
nis2onto-ops:simulates rdf:type owl:ObjectProperty ;
                       rdfs:domain nis2onto-ops:SoftwareApplication ;
                       rdfs:range nis2onto-ops:Asset ;
                       rdfs:comment "Software application can simulate an asset."@en ;
                       rdfs:label "simulates"@en .


###  https://w3id.org/nis2onto-ops#supportedByEvidenceRecord
nis2onto-ops:supportedByEvidenceRecord rdf:type owl:ObjectProperty ;
                                       owl:inverseOf nis2onto-ops:supportsControlTheme ;
                                       rdfs:domain nis2onto-ops:ControlTheme ;
                                       rdfs:range nis2onto-ops:EvidenceRecord ;
                                       rdfs:comment "Control theme is supported by a compliance evidence record."@en ;
                                       rdfs:label "supported by evidence record"@en .


###  https://w3id.org/nis2onto-ops#supportsControlTheme
nis2onto-ops:supportsControlTheme rdf:type owl:ObjectProperty ;
                                  rdfs:domain nis2onto-ops:EvidenceRecord ;
                                  rdfs:range nis2onto-ops:ControlTheme ;
                                  rdfs:comment "Evidence record records compliance to a control theme."@en ;
                                  rdfs:label "supports control theme"@en .


###  https://w3id.org/nis2onto-ops#usesRule
nis2onto-ops:usesRule rdf:type owl:ObjectProperty ;
                      rdfs:range [ rdf:type owl:Class ;
                                   owl:unionOf ( nis2onto-ops:ComplianceRule
                                                 nis2onto-ops:DetectionRule
                                               )
                                 ] ;
                      rdfs:comment "Entity uses a rule as a trigger or decision ruling."@en ;
                      rdfs:label "uses rule"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/nis2onto-ops#hasAlertTimestamp
nis2onto-ops:hasAlertTimestamp rdf:type owl:DatatypeProperty ;
                               rdfs:range xsd:dateTime ;
                               rdfs:comment "Datetime timestamp record for a triggered alert (e.g. a Wazuh rule trigger)."@en ;
                               rdfs:label "has alert timestamp"@en .


###  https://w3id.org/nis2onto-ops#hasBlockchainTxID
nis2onto-ops:hasBlockchainTxID rdf:type owl:DatatypeProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:range xsd:string ;
                               rdfs:comment "Blockchain transaction id string."@en ;
                               rdfs:label "has blockchain transaction ID"@en .


###  https://w3id.org/nis2onto-ops#hasCVSSScore
nis2onto-ops:hasCVSSScore rdf:type owl:DatatypeProperty ;
                          rdfs:range xsd:float ;
                          rdfs:comment "Float Common Vulnerability Scoring System (CVSS) score."@en ;
                          rdfs:label "has CVSS score"@en .


###  https://w3id.org/nis2onto-ops#hasEndpoint
nis2onto-ops:hasEndpoint rdf:type owl:DatatypeProperty ;
                         rdfs:domain nis2onto-ops:SoftwareAsset ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Software endpoint string."@en ;
                         rdfs:label "has endpoint"@en .


###  https://w3id.org/nis2onto-ops#hasHashValue
nis2onto-ops:hasHashValue rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain nis2onto-ops:HashDigest ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Hash value string."@en ;
                          rdfs:label "has hash value"@en .


###  https://w3id.org/nis2onto-ops#hasID
nis2onto-ops:hasID rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:range xsd:string ;
                   rdfs:comment "ID string."@en ;
                   rdfs:label "has ID"@en .


###  https://w3id.org/nis2onto-ops#hasScoreGrade
nis2onto-ops:hasScoreGrade rdf:type owl:DatatypeProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:range xsd:string ;
                           rdfs:comment "Grade score value."@en ;
                           rdfs:label "has score grade"@en .


###  https://w3id.org/nis2onto-ops#hasScoreValue
nis2onto-ops:hasScoreValue rdf:type owl:DatatypeProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:range xsd:float ;
                           rdfs:comment "Float score value."@en ;
                           rdfs:label "has score value"@en .


###  https://w3id.org/nis2onto-ops#hasTimestamp
nis2onto-ops:hasTimestamp rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:range xsd:dateTime ;
                          rdfs:comment "Datetime timestamp record."@en ;
                          rdfs:label "has timestamp"@en .


###  https://w3id.org/nis2onto-ops#hasURL
nis2onto-ops:hasURL rdf:type owl:DatatypeProperty ;
                    rdfs:range xsd:string ;
                    rdfs:comment "URL string."@en ;
                    rdfs:label "has URL"@en .


###  https://w3id.org/nis2onto-ops#isConvertedToValue
nis2onto-ops:isConvertedToValue rdf:type owl:DatatypeProperty ;
                                rdfs:range xsd:float ;
                                rdfs:comment "Non-numerical entry converted to a numerical value."@en ;
                                rdfs:label "is converted to value"@en .


###  https://w3id.org/nis2onto-ops#isSimulatedAsset
nis2onto-ops:isSimulatedAsset rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain nis2onto-ops:Asset ;
                              rdfs:range xsd:boolean ;
                              rdfs:comment "Boolean for a an asset to be declared as a simulated asset."@en ;
                              rdfs:label "is simulated asset"@en .


###  https://w3id.org/nis2onto-ops#notes
nis2onto-ops:notes rdf:type owl:DatatypeProperty ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Note field string."@en ;
                   rdfs:label "notes"@en .


###  https://w3id.org/nis2onto-ops#relatedToENISATechnicalGuideSection
nis2onto-ops:relatedToENISATechnicalGuideSection rdf:type owl:DatatypeProperty ;
                                                 rdfs:range xsd:string ;
                                                 rdfs:comment "ENISA technical guide section string."@en ;
                                                 rdfs:label "related to ENISA technical guide section"@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/nis2onto-ops#AlertEvidenceRecord
nis2onto-ops:AlertEvidenceRecord rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( nis2onto-ops:EvidenceRecord
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty nis2onto-ops:hasSeverity ;
                                                                              owl:someValuesFrom [ owl:intersectionOf ( nis2onto-ops:Severity
                                                                                                                        [ rdf:type owl:Class ;
                                                                                                                          owl:complementOf [ rdf:type owl:Class ;
                                                                                                                                             owl:oneOf ( nis2onto-ops:info_severity
                                                                                                                                                       )
                                                                                                                                           ]
                                                                                                                        ]
                                                                                                                      ) ;
                                                                                                   rdf:type owl:Class
                                                                                                 ]
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:subClassOf nis2onto-ops:EvidenceRecord ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty nis2onto-ops:supportsControlTheme ;
                                                   owl:hasValue nis2onto-ops:severity_classification
                                                 ] ;
                                 rdfs:comment "Evidence record documenting a security alert that was triggered."@en ;
                                 rdfs:label "Alert Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#AnomalyDetection
nis2onto-ops:AnomalyDetection rdf:type owl:Class ;
                              rdfs:subClassOf nis2onto:Assessment ;
                              rdfs:comment "Assessment method that identifies deviations from expected or normal behavior."@en ;
                              rdfs:label "Anomaly Detection"@en .


###  https://w3id.org/nis2onto-ops#ArterySimulator
nis2onto-ops:ArterySimulator rdf:type owl:Class ;
                             rdfs:subClassOf nis2onto-ops:CAVSimulator ;
                             rdfs:comment "Artery communication simulator (V2X)."@en ;
                             rdfs:label "Artery Simulator"@en .


###  https://w3id.org/nis2onto-ops#Asset
nis2onto-ops:Asset rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty nis2onto-ops:hasCriticality ;
                                     owl:someValuesFrom nis2onto-ops:Criticality
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty nis2onto-ops:hasID ;
                                     owl:someValuesFrom xsd:string
                                   ] ;
                   rdfs:comment "Any IT, OT, or CAV component, system, or service that is part of the monitored environment."@en ;
                   rdfs:label "Asset"@en .


###  https://w3id.org/nis2onto-ops#AssetAttack
nis2onto-ops:AssetAttack rdf:type owl:Class ;
                         rdfs:subClassOf nis2onto-ops:Attack ;
                         rdfs:comment "Attack directed at a specific asset."@en ;
                         rdfs:label "Asset Attack"@en .


###  https://w3id.org/nis2onto-ops#AssetEvent
nis2onto-ops:AssetEvent rdf:type owl:Class ;
                        rdfs:subClassOf nis2onto:Event ;
                        rdfs:comment "Event that occurs on, or involves, an asset."@en ;
                        rdfs:label "Asset Event"@en .


###  https://w3id.org/nis2onto-ops#AssetEvidenceRecord
nis2onto-ops:AssetEvidenceRecord rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( nis2onto-ops:EvidenceRecord
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty nis2onto-ops:assessesAsset ;
                                                                              owl:someValuesFrom nis2onto-ops:Asset
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:subClassOf nis2onto-ops:EvidenceRecord ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty nis2onto-ops:supportsControlTheme ;
                                                   owl:hasValue nis2onto-ops:asset_evidence_documentation
                                                 ] ;
                                 rdfs:comment "Evidence record documenting the assessment of an asset."@en ;
                                 rdfs:label "Asset Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#AssetInventoryAndManagement
nis2onto-ops:AssetInventoryAndManagement rdf:type owl:Class ;
                                         rdfs:subClassOf nis2onto-ops:ControlTheme ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty nis2onto-ops:governedBy ;
                                                           owl:someValuesFrom nis2onto:Art21Par2-i-Entity
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty nis2onto-ops:relatedToENISATechnicalGuideSection ;
                                                           owl:hasValue "12.4"
                                                         ] ;
                                         rdfs:comment "Control theme covering the identification, inventory, and lifecycle tracking of assets relevant to the security of network and information systems."@en ;
                                         rdfs:label "Asset Inventory and Management"@en .


###  https://w3id.org/nis2onto-ops#AssetOwner
nis2onto-ops:AssetOwner rdf:type owl:Class ;
                        rdfs:subClassOf nis2onto:Actor ;
                        rdfs:comment "Entity that holds legal, operational, or financial rights to an asset."@en ;
                        rdfs:label "Asset Owner"@en .


###  https://w3id.org/nis2onto-ops#Attack
nis2onto-ops:Attack rdf:type owl:Class ;
                    rdfs:subClassOf nis2onto:Incident ;
                    rdfs:comment "Malicious event that attempts to compromise the confidentiality, integrity, or availability of an asset."@en ;
                    rdfs:label "Attack"@en .


###  https://w3id.org/nis2onto-ops#AttackEvidenceRecord
nis2onto-ops:AttackEvidenceRecord rdf:type owl:Class ;
                                  owl:equivalentClass [ owl:intersectionOf ( nis2onto-ops:EvidenceRecord
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty nis2onto-ops:recordsEvent ;
                                                                               owl:someValuesFrom nis2onto-ops:Attack
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] ;
                                  rdfs:subClassOf nis2onto-ops:EventEvidenceRecord ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty nis2onto-ops:supportsControlTheme ;
                                                    owl:hasValue nis2onto-ops:component_integrity_evaluation
                                                  ] ;
                                  rdfs:comment "Evidence record documenting the occurrence of an attack."@en ;
                                  rdfs:label "Attack Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#AttackTactic
nis2onto-ops:AttackTactic rdf:type owl:Class ;
                          rdfs:subClassOf nis2onto-ops:SecurityCatalogReference ;
                          rdfs:comment "An adversary's tactical objective (the 'why' of an attack), drawn from the MITRE ATT&CK knowledge base."@en ;
                          rdfs:label "Attack Tactic"@en .


###  https://w3id.org/nis2onto-ops#AttackTechnique
nis2onto-ops:AttackTechnique rdf:type owl:Class ;
                             rdfs:subClassOf nis2onto-ops:SecurityCatalogReference ;
                             rdfs:comment "A documented, adversary behavior describing how an attacker achieves a tactical objective, drawn from the MITRE ATT&CK knowledge base."@en ;
                             rdfs:label "Attack Technique"@en .


