                                    rdfs:label "Certificate Validation"@en .


###  https://w3id.org/nis2onto-ops#compliant
nis2onto-ops:compliant rdf:type owl:NamedIndividual ,
                                nis2onto-ops:ControlStatus ;
                       rdfs:comment "Status indicating the scope is fully supported by sufficient, current evidence."@en ;
                       rdfs:label "Compliant"@en .


###  https://w3id.org/nis2onto-ops#component_authentication_and_authorisation
nis2onto-ops:component_authentication_and_authorisation rdf:type owl:NamedIndividual ,
                                                                 nis2onto-ops:AuthenticationAndAccessControl ,
                                                                 nis2onto-ops:CryptographicProtection ;
                                                        rdfs:comment "Component identity and access verification and control, e.g., authentication checks on API calls."@en ;
                                                        rdfs:label "Component Authentication and Authorisation"@en .


###  https://w3id.org/nis2onto-ops#component_integrity_evaluation
nis2onto-ops:component_integrity_evaluation rdf:type owl:NamedIndividual ,
                                                     nis2onto-ops:CryptographicProtection ,
                                                     nis2onto-ops:EventAnalysisAndClassification ,
                                                     nis2onto-ops:IncidentDetectionAndMonitoring ;
                                            rdfs:comment "Component integrity monitoring and event analysis, e.g., routine RAIM checks, spoofing attacks."@en ;
                                            rdfs:label "Component Integrity Evaluation"@en .


###  https://w3id.org/nis2onto-ops#configuration_auditing
nis2onto-ops:configuration_auditing rdf:type owl:NamedIndividual ,
                                             nis2onto-ops:SecurityPostureAndControlEffectiveness ;
                                    rdfs:comment "Evaluation of assets against established security baselines and best practices, e.g., Wazuh SCA scans."@en ;
                                    rdfs:label "Configuration Auditing"@en .


###  https://w3id.org/nis2onto-ops#container_policy_scan
nis2onto-ops:container_policy_scan rdf:type owl:NamedIndividual ,
                                            nis2onto-ops:PolicyBasedScan ;
                                   rdfs:comment "Checks container images and configurations for policy compliance."@en ;
                                   rdfs:label "Container Policy Scan"@en .


