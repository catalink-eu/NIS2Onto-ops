nis2onto-ops:behavioral_baseline_deviation rdf:type owl:NamedIndividual ,
                                                    nis2onto-ops:AnomalyDetection ;
                                           rdfs:comment "Flags deviation from an established behavioral baseline."@en ;
                                           rdfs:label "Behavioral Baseline Deviation"@en .


