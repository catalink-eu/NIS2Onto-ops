nis2onto-ops:authentication_check rdf:type owl:NamedIndividual ,
                                           nis2onto-ops:AuthenticationCheck ;
                                  rdfs:comment "Generic authentication check verifying credentials presented by an entity."@en ;
                                  rdfs:label "Authentication Check"@en .


