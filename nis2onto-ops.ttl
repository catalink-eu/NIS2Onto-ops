###  https://w3id.org/nis2onto-ops#CROSSCORE
:CROSSCORE rdf:type owl:NamedIndividual ,
                    :CybersecuritySoftwareModule ;
           :hasCriticality :n_a ;
           :hasID "CROSSCORE" ;
