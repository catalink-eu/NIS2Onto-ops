nis2onto-ops:ai_segmentation_divergent rdf:type owl:NamedIndividual ,
                                                nis2onto-ops:CAV2DSegmentationAIEvent ;
                                       rdfs:comment "Event in which the 2D image segmentation output disagrees beyond tolerance with an independently trained reference model or with the HD map."@en ;
                                       rdfs:label "AI Segmentation Divergent"@en .


###  https://w3id.org/nis2onto-ops#anomaly
nis2onto-ops:anomaly rdf:type owl:NamedIndividual ,
                              nis2onto-ops:MonitoringOutcome ;
                     rdfs:comment "Monitoring outcome indicating that an anomaly was detected."@en ;
                     rdfs:label "Anomaly"@en .


