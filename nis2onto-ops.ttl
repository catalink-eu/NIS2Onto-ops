                rdfs:subClassOf :SoftwareAsset ;
                rdfs:comment "Software unit responsible for a specific function."@en ;
                rdfs:label "Software Module"@en .


###  https://w3id.org/nis2onto-ops#StreamPatternMatching
:StreamPatternMatching rdf:type owl:Class ;
                       rdfs:subClassOf :RuleBasedAssessment ;
                       rdfs:comment "Rule-based assessment that matches patterns within a continuous data stream."@en ;
                       rdfs:label "Stream Pattern Matching"@en .


###  https://w3id.org/nis2onto-ops#SupplyChainSecurity
:SupplyChainSecurity rdf:type owl:Class ;
                     rdfs:subClassOf :ControlTheme ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :governedBy ;
                                       owl:someValuesFrom nis2onto:Art21Par2-d-Entity
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :relatedToENISATechnicalGuideSection ;
                                       owl:hasValue "5.1"^^xsd:string
                                     ] ;
                     rdfs:comment "Control theme covering the identification and management of risks arising from suppliers, service providers, and third-party software components in the network and information systems supply chain."@en ;
                     rdfs:label "Supply Chain Security"@en .


###  https://w3id.org/nis2onto-ops#Suricata
:Suricata rdf:type owl:Class ;
          rdfs:subClassOf nis2onto:CybersecurityTool ,
                          :CybersecuritySoftwareApplication ;
          rdfs:comment "Suricata is an open-source Network Intrusion Detection System (NIDS), Intrusion Prevention System (IPS), and Network Security Monitoring (NSM) engine that performs deep packet inspection and watches network traffic for malicious patterns, policy violations, and suspicious anomalies."@en ;
          rdfs:label "Suricata"@en .


###  https://w3id.org/nis2onto-ops#ThreatEvidenceRecord
:ThreatEvidenceRecord rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :EvidenceRecord
                                                                 [ rdf:type owl:Class ;
                                                                   owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty :recordsAttackTactic ;
                                                                                   owl:someValuesFrom :AttackTactic
                                                                                 ]
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty :recordsAttackTechnique ;
                                                                                   owl:someValuesFrom :AttackTechnique
                                                                                 ]
                                                                               )
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf :CTIEnrichedEvidenceRecord ;
                      rdfs:comment "Evidence record documenting an attack tactic or technique from the MITRE ATT&CK knowledge base."@en ;
                      rdfs:label "Threat Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#VulnerabilityEvidenceRecord
:VulnerabilityEvidenceRecord rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( :EvidenceRecord
                                                                        [ rdf:type owl:Class ;
                                                                          owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty :recordsVulnerability ;
                                                                                          owl:someValuesFrom :CVE
                                                                                        ]
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty :recordsWeakness ;
                                                                                          owl:someValuesFrom :CWE
                                                                                        ]
                                                                                      )
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             rdfs:subClassOf :CTIEnrichedEvidenceRecord ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :supportsControlTheme ;
                                               owl:hasValue :cve_cwe_disclosure
                                             ] ;
                             rdfs:comment "Evidence record documenting a vulnerability/weakness from a CVE/CWE."@en ;
                             rdfs:label "Vulnerability Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#VulnerabilityHandlingAndDisclosure
:VulnerabilityHandlingAndDisclosure rdf:type owl:Class ;
                                    rdfs:subClassOf :ControlTheme ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :governedBy ;
                                                      owl:someValuesFrom nis2onto:Art21Par2-e-Entity
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty :relatedToENISATechnicalGuideSection ;
                                                      owl:hasValue "6.10"^^xsd:string
                                                    ] ;
                                    rdfs:comment "Control theme covering the identification, handling, and coordinated disclosure of vulnerabilities affecting network and information systems."@en ;
                                    rdfs:label "Vulnerability Handling and Disclosure"@en .


###  https://w3id.org/nis2onto-ops#Wazuh
:Wazuh rdf:type owl:Class ;
       rdfs:subClassOf nis2onto:CybersecurityTool ,
                       :CybersecuritySoftwareApplication ;
       rdfs:comment "Wazuh is an open-source, enterprise-grade security monitoring platform that uses agents to collect, analyze, and correlate logs in real-time, offering file integrity monitoring, vulnerability detection, and incident response."@en ;
       rdfs:label "Wazuh"@en .


