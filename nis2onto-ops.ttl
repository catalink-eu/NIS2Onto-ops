###  https://w3id.org/nis2onto-ops#CTIEnrichedEvidenceRecord
:CTIEnrichedEvidenceRecord rdf:type owl:Class ;
                           rdfs:subClassOf :EvidenceRecord ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :producedBy ;
                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                  owl:unionOf ( :MISP
                                                                                :Snyk
                                                                                :Suricata
                                                                                :Wazuh
                                                                              )
                                                                ]
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :supportsControlTheme ;
                                             owl:hasValue :cti_enrichment
                                           ] ;
                           rdfs:comment "Evidence record enriched by external CTI (Cyber Threat Intelligence)."@en ;
                           rdfs:label "CTI-Enriched Evidence Record"@en .


###  https://w3id.org/nis2onto-ops#CVE
:CVE rdf:type owl:Class ;
     rdfs:subClassOf :SecurityCatalogReference ;
     rdfs:comment "Common Vulnerabilities and Exposures (CVE) are publicly disclosed and uniquely identified cybersecurity vulnerabilities affecting software, hardware, or firmware systems."@en ;
     rdfs:label "CVE"@en .


###  https://w3id.org/nis2onto-ops#CWE
:CWE rdf:type owl:Class ;
     rdfs:subClassOf :SecurityCatalogReference ;
     rdfs:comment "Common Weakness Enumeration (CWE) categorizes common software and hardware weaknesses that can contribute to the existence of one or more cybersecurity vulnerabilities."@en ;
     rdfs:label "CWE"@en .


###  https://w3id.org/nis2onto-ops#ComplianceMonitoring
:ComplianceMonitoring rdf:type owl:Class ;
                      rdfs:subClassOf :ControlTheme ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :governedBy ;
                                        owl:someValuesFrom nis2onto:Art21Par2-a-Entity
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :relatedToENISATechnicalGuideSection ;
                                        owl:hasValue "2.2"^^xsd:string
                                      ] ;
                      rdfs:comment "Control theme covering the regular review of compliance with security policies, rules, and standards, and the reporting of compliance status to management bodies."@en ;
                      rdfs:label "Compliance Monitoring"@en .


###  https://w3id.org/nis2onto-ops#ComplianceRule
:ComplianceRule rdf:type owl:Class ;
                rdfs:subClassOf :SecurityCatalogReference ;
                rdfs:comment "Rule used to derive a control compliance ruling."@en ;
                rdfs:label "Compliance Rule"@en .


###  https://w3id.org/nis2onto-ops#ComputeHost
:ComputeHost rdf:type owl:Class ;
             rdfs:subClassOf :ITAsset ;
             rdfs:comment "A physical or virtual machine that hosts software assets."@en ;
             rdfs:label "Compute Host"@en .


###  https://w3id.org/nis2onto-ops#ControlGovernance
:ControlGovernance rdf:type owl:Class ;
                   rdfs:comment "Organizational grouping for the concepts used to define, scope, and evaluate compliance controls."@en ;
                   rdfs:label "Control Governance"@en .


###  https://w3id.org/nis2onto-ops#ControlRuling
:ControlRuling rdf:type owl:Class ;
               rdfs:subClassOf :ControlGovernance ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :evidencedBy ;
                                 owl:someValuesFrom :EvidenceRecord
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasControlScope ;
                                 owl:someValuesFrom :ControlScope
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasControlStatus ;
                                 owl:someValuesFrom :ControlStatus
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasRemediationScore ;
                                 owl:someValuesFrom :RemediationScore
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :usesRule ;
                                 owl:someValuesFrom :ComplianceRule
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasTimestamp ;
                                 owl:someValuesFrom xsd:dateTime
                               ] ;
               rdfs:comment "Reified, auditable record of a single compliance judgement: the scope it evaluates, the evidence records it was computed from, the status it produced, and when and by which rule it was derived."@en ;
               rdfs:label "Control Ruling"@en .


###  https://w3id.org/nis2onto-ops#ControlScope
:ControlScope rdf:type owl:Class ;
              rdfs:subClassOf :ControlGovernance ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasInScopeAsset ;
                                owl:someValuesFrom :Asset
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasInScopeControlTheme ;
                                owl:someValuesFrom :ControlTheme
                              ] ;
              rdfs:comment "Boundary of a compliance evaluation, defined by the asset(s) and control theme(s) it covers."@en ;
              rdfs:label "Control Scope"@en .


###  https://w3id.org/nis2onto-ops#ControlStatus
:ControlStatus rdf:type owl:Class ;
               rdfs:subClassOf :ControlGovernance ;
               rdfs:comment "Outcome classification of a control derivation."@en ;
               rdfs:label "Control Status"@en .


###  https://w3id.org/nis2onto-ops#ControlTheme
:ControlTheme rdf:type owl:Class ;
              rdfs:subClassOf :ControlGovernance ;
              rdfs:comment "A category of security controls, such as authentication or incident response, that compliance is evaluated against."@en ;
              rdfs:label "Control Theme"@en .


###  https://w3id.org/nis2onto-ops#Criticality
:Criticality rdf:type owl:Class ;
             rdfs:subClassOf :RiskRating ;
             rdfs:comment "Asset criticality classification: Critical, High, Medium, Low, or N/A."@en ;
             rdfs:label "Criticality"@en .


###  https://w3id.org/nis2onto-ops#CryptographicProtection
:CryptographicProtection rdf:type owl:Class ;
                         rdfs:subClassOf :ControlTheme ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :governedBy ;
                                           owl:someValuesFrom nis2onto:Art21Par2-h-Entity
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :relatedToENISATechnicalGuideSection ;
                                           owl:hasValue "9.1"^^xsd:string
                                         ] ;
                         rdfs:comment "Control theme covering the policy and use of cryptographic mechanisms to protect the confidentiality, integrity, and authenticity of data."@en ;
                         rdfs:label "Cryptographic Protection"@en .


