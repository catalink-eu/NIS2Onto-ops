:SecurityPostureAndControlEffectiveness rdf:type owl:Class ;
                                        rdfs:subClassOf :ControlTheme ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :governedBy ;
                                                          owl:someValuesFrom nis2onto:Art21Par2-f-Entity
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :relatedToENISATechnicalGuideSection ;
                                                          owl:hasValue "7"^^xsd:string
                                                        ] ;
                                        rdfs:comment "Control theme covering the policies and procedures used to assess the effectiveness of implemented cybersecurity risk-management measures."@en ;
                                        rdfs:label "Security Posture and Control Effectiveness"@en .


###  https://w3id.org/nis2onto-ops#Severity
:Severity rdf:type owl:Class ;
          rdfs:subClassOf :RiskRating ;
          rdfs:comment "Classification of how serious a vulnerability, weakness, or incident is."@en ;
          rdfs:label "Severity"@en .


###  https://w3id.org/nis2onto-ops#SignatureMatching
:SignatureMatching rdf:type owl:Class ;
