nis2onto-ops:anomaly_detector_detection rdf:type owl:NamedIndividual ,
                                                 nis2onto-ops:AnomalyDetection ;
                                        rdfs:comment "Generic anomaly-detection assessment method for identifying abnormal behavior."@en ;
                                        rdfs:label "Anomaly Detector Detection"@en .


