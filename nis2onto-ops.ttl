nis2onto-ops:can_bus_anomaly_detection rdf:type owl:NamedIndividual ,
                                                nis2onto-ops:AnomalyDetection ;
                                       rdfs:comment "Monitors CAN bus traffic for abnormal patterns."@en ;
                                       rdfs:label "CAN Bus Anomaly Detection"@en .


