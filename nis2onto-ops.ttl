                                       rdfs:subClassOf nis2onto-ops:EvidenceRecord ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty nis2onto-ops:producedBy ;
                                                         owl:someValuesFrom [ rdf:type owl:Class ;
                                                                              owl:unionOf ( nis2onto-ops:MISP
                                                                                            nis2onto-ops:Snyk
                                                                                            nis2onto-ops:Suricata
                                                                                            nis2onto-ops:Wazuh
                                                                                          )
                                                                            ]
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty nis2onto-ops:supportsControlTheme ;
                                                         owl:hasValue nis2onto-ops:cti_enrichment
                                                       ] ;
                                       rdfs:comment "Evidence record enriched by external CTI (Cyber Threat Intelligence)."@en ;
                                       rdfs:label "CTI-Enriched Evidence Record"@en .


