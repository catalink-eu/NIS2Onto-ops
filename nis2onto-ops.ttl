:CybersecuritySoftwareApplication rdf:type owl:Class ;
                                  rdfs:subClassOf :SoftwareApplication ;
                                  rdfs:comment "Software application dedicated to cybersecurity monitoring, detection, scanning, or protection."@en ;
                                  rdfs:label "Cybersecurity Software Application"@en .


