  } ]
}, {
  "@id" : "https://w3id.org/nis2onto-ops",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "NIS2Onto-ops is an operational ontology that extends NIS2Onto with the concepts needed to monitor assets, track security events, and record cybersecurity evidence in the context of NIS2 Article 21 risk-management obligations. It adds a compliance-governance layer that ties control judgements back to specific regulatory requirements, enabling automated, evidence-based classification of compliance status over time. Developed as part of the NIS2Graph project."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "NIS2Onto-ops"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "http://www.unict.it/nas-inf/nis2onto/nis2onto.owl"
  } ]
} ]