<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="https://w3id.org/nis2onto-ops"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="https://w3id.org/nis2onto-ops">
    <Prefix name="" IRI="https://w3id.org/nis2onto-ops#"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <Prefix name="xml" IRI="http://www.w3.org/XML/1998/namespace"/>
    <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
    <Prefix name="swrla" IRI="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"/>
    <Prefix name="nis2onto" IRI="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#"/>
    <Import>http://www.unict.it/nas-inf/nis2onto/nis2onto.owl</Import>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">NIS2Onto-ops is an operational ontology that extends NIS2Onto with the concepts needed to monitor assets, track security events, and record cybersecurity evidence in the context of NIS2 Article 21 risk-management obligations. It adds a compliance-governance layer that ties control judgements back to specific regulatory requirements, enabling automated, evidence-based classification of compliance status over time. Developed as part of the NIS2Graph project.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <Literal xml:lang="en">NIS2Onto-ops</Literal>
    </Annotation>
