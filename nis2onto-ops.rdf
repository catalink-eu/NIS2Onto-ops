        <rdfs:label xml:lang="en">Risk Rating</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#RuleBasedAssessment -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#RuleBasedAssessment">
