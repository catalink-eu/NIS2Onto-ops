<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/nis2onto-ops"
     xml:base="https://w3id.org/nis2onto-ops"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:nis2onto="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#"
     xmlns:nis2onto-ops="https://w3id.org/nis2onto-ops#">
    <owl:Ontology rdf:about="https://w3id.org/nis2onto-ops">
        <owl:imports rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl"/>
        <rdfs:comment xml:lang="en">NIS2Onto-ops is an operational ontology that extends NIS2Onto with the concepts needed to monitor assets, track security events, and record cybersecurity evidence in the context of NIS2 Article 21 risk-management obligations. It adds a compliance-governance layer that ties control judgements back to specific regulatory requirements, enabling automated, evidence-based classification of compliance status over time. Developed as part of the NIS2Graph project.</rdfs:comment>
        <rdfs:label xml:lang="en">NIS2Onto-ops</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/nis2onto-ops#achievesAttackTactic -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#achievesAttackTactic">
        <owl:inverseOf rdf:resource="https://w3id.org/nis2onto-ops#isAchievedByAttackTechnique"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#AttackTechnique"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#AttackTactic"/>
        <rdfs:comment xml:lang="en">Technique that serves a MITRE ATT&amp;CK tactic.</rdfs:comment>
        <rdfs:label xml:lang="en">achieves attack tactic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#assessedByEvidenceRecord -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#assessedByEvidenceRecord">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:comment xml:lang="en">Asset is assed by an evidence record.</rdfs:comment>
        <rdfs:label xml:lang="en">assessed by evidence record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#assessesAsset -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#assessesAsset">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:comment xml:lang="en">Evidence record asseses an asset.</rdfs:comment>
        <rdfs:label xml:lang="en">assesses asset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#causedByVulnerability -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#causedByVulnerability">
        <owl:inverseOf rdf:resource="https://w3id.org/nis2onto-ops#hasCausalWeakness"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#CWE"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#CVE"/>
        <rdfs:comment xml:lang="en">Underlying weakness causes a vulnerability.</rdfs:comment>
        <rdfs:label xml:lang="en">caused by vulnerability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#communicatesWith -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#communicatesWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:comment xml:lang="en">Asset communicates with another asset.</rdfs:comment>
        <rdfs:label xml:lang="en">communicates with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#evidencedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#evidencedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/nis2onto-ops#evidences"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#ControlRuling"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:comment xml:lang="en">Control ruling is evidenced by an evidence record.</rdfs:comment>
        <rdfs:label xml:lang="en">evidenced by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#evidences -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#evidences">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#ControlRuling"/>
        <rdfs:comment xml:lang="en">Evidence record evidences a control ruling.</rdfs:comment>
        <rdfs:label xml:lang="en">evidences</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#followedByEvent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#followedByEvent">
        <owl:inverseOf rdf:resource="https://w3id.org/nis2onto-ops#followsEvent"/>
        <rdfs:domain rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Event"/>
        <rdfs:range rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Event"/>
        <rdfs:comment xml:lang="en">Event followed by another event.</rdfs:comment>
        <rdfs:label xml:lang="en">followed by event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#followedByEvidenceRecord -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#followedByEvidenceRecord">
        <owl:inverseOf rdf:resource="https://w3id.org/nis2onto-ops#followsEvidenceRecord"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:comment xml:lang="en">Evidence record is followed by another record.</rdfs:comment>
        <rdfs:label xml:lang="en">followed by evidence record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#followsEvent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#followsEvent">
        <rdfs:domain rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Event"/>
        <rdfs:range rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Event"/>
        <rdfs:comment xml:lang="en">Event is a followup to another event.</rdfs:comment>
        <rdfs:label xml:lang="en">follows event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#followsEvidenceRecord -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#followsEvidenceRecord">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:comment xml:lang="en">Evidence record is a followup to another record.</rdfs:comment>
        <rdfs:label xml:lang="en">follows evidence record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#governedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#governedBy">
        <rdfs:comment xml:lang="en">Entity governed by NIS2 article.</rdfs:comment>
        <rdfs:label xml:lang="en">governed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasCausalWeakness -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasCausalWeakness">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#CVE"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#CWE"/>
        <rdfs:comment xml:lang="en">Vulnerability exists because it has a specific underlying causal weakness.</rdfs:comment>
        <rdfs:label xml:lang="en">has causal weakness</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasComponent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasComponent">
        <owl:inverseOf rdf:resource="https://w3id.org/nis2onto-ops#isComponentOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:comment xml:lang="en">Asset has another asset as a component of itself.</rdfs:comment>
        <rdfs:label xml:lang="en">has component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasControlScope -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasControlScope">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#ControlRuling"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#ControlScope"/>
        <rdfs:comment xml:lang="en">Control ruling evaluates a specific control scope.</rdfs:comment>
        <rdfs:label xml:lang="en">has control scope</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasControlStatus -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasControlStatus">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#ControlRuling"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#ControlStatus"/>
        <rdfs:comment xml:lang="en">Control ruling is assigned a control status as its outcome.</rdfs:comment>
        <rdfs:label xml:lang="en">has control status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasCriticality -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasCriticality">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#Criticality"/>
        <rdfs:comment xml:lang="en">Asset has a criticality classification.</rdfs:comment>
        <rdfs:label xml:lang="en">has criticality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasFileFormat -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasFileFormat">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#Document"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#FileFormat"/>
        <rdfs:comment xml:lang="en">Document has a file format.</rdfs:comment>
        <rdfs:label xml:lang="en">has file format</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasHashDigest -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasHashDigest">
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#HashDigest"/>
        <rdfs:comment xml:lang="en">Entity was hashed and has a hash digest.</rdfs:comment>
        <rdfs:label xml:lang="en">has hash digest</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasInScopeAsset -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasInScopeAsset">
        <owl:inverseOf rdf:resource="https://w3id.org/nis2onto-ops#isAssetInScope"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#ControlScope"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:comment xml:lang="en">Control scope has an asset as part of its evaluation boundary.</rdfs:comment>
        <rdfs:label xml:lang="en">has in-scope asset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasInScopeControlTheme -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasInScopeControlTheme">
        <owl:inverseOf rdf:resource="https://w3id.org/nis2onto-ops#isControlThemeInScope"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#ControlScope"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:comment xml:lang="en">Control scope has a control theme as part of its evaluation boundary.</rdfs:comment>
        <rdfs:label xml:lang="en">has in-scope control theme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasOwner -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasOwner">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:comment xml:lang="en">Asset is owned by an entity.</rdfs:comment>
        <rdfs:label xml:lang="en">has owner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasPostureScore -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasPostureScore">
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#PostureScore"/>
        <rdfs:comment xml:lang="en">Entity has a posture score.</rdfs:comment>
        <rdfs:label xml:lang="en">has posture score</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasPreviousControlRuling -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasPreviousControlRuling">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#ControlRuling"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#ControlRuling"/>
        <rdfs:comment xml:lang="en">Control ruling has a previous ruling.</rdfs:comment>
        <rdfs:label xml:lang="en">has previous control ruling</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasRemediationScore -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasRemediationScore">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#ControlRuling"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#RemediationScore"/>
        <rdfs:comment xml:lang="en">Control ruling has a remediation score.</rdfs:comment>
        <rdfs:label xml:lang="en">has remediation score</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasSeverity -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasSeverity">
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#Severity"/>
        <rdfs:comment xml:lang="en">Entity has a severity classification.</rdfs:comment>
        <rdfs:label xml:lang="en">has severity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasSoftwareDependency -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hasSoftwareDependency">
        <owl:inverseOf rdf:resource="https://w3id.org/nis2onto-ops#isSoftwareDependencyOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#SoftwareAsset"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#SoftwareAsset"/>
        <rdfs:comment xml:lang="en">Software has another software as a dependency.</rdfs:comment>
        <rdfs:label xml:lang="en">has software dependency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hashedUsing -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#hashedUsing">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#HashDigest"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#HashAlgorithm"/>
        <rdfs:comment xml:lang="en">Hash digest created using a hash algorithm.</rdfs:comment>
        <rdfs:label xml:lang="en">hashed using</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#isAchievedByAttackTechnique -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#isAchievedByAttackTechnique">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#AttackTactic"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#AttackTechnique"/>
        <rdfs:comment xml:lang="en">Tactic that is achieved by a MITRE ATT&amp;CK technique.</rdfs:comment>
        <rdfs:label xml:lang="en">is achieved by attack technique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#isAssetInScope -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#isAssetInScope">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#ControlScope"/>
        <rdfs:comment xml:lang="en">Asset is an in-scope asset of a control scope.</rdfs:comment>
        <rdfs:label xml:lang="en">has asset in scope</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#isComponentOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#isComponentOf">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:comment xml:lang="en">Asset is component of another asset.</rdfs:comment>
        <rdfs:label xml:lang="en">is component of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#isControlThemeInScope -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#isControlThemeInScope">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#ControlScope"/>
        <rdfs:comment xml:lang="en">Control theme is an in-scope control theme of a control scope.</rdfs:comment>
        <rdfs:label xml:lang="en">has control theme in scope</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#isSoftwareDependencyOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#isSoftwareDependencyOf">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#SoftwareAsset"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#SoftwareAsset"/>
        <rdfs:comment xml:lang="en">Software is a dependency of another software.</rdfs:comment>
        <rdfs:label xml:lang="en">is software dependency of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#owns -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#owns">
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:comment xml:lang="en">Entity owns an asset.</rdfs:comment>
        <rdfs:label xml:lang="en">owns</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#producedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#producedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/nis2onto-ops#produces"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Assessment"/>
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#SoftwareApplication"/>
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#SoftwareModule"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Source of evidence record.</rdfs:comment>
        <rdfs:label xml:lang="en">produced by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#produces -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#produces">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Assessment"/>
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#SoftwareApplication"/>
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#SoftwareModule"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:label xml:lang="en">Source that produces an evidence record.</rdfs:label>
        <rdfs:label xml:lang="en">produces</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#recordedOnLedger -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#recordedOnLedger">
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#Ledger"/>
        <rdfs:comment xml:lang="en">Entity is recorded on a ledger for integrity.</rdfs:comment>
        <rdfs:label xml:lang="en">recorded on ledger</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#recordsAttackTactic -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#recordsAttackTactic">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#AttackTactic"/>
        <rdfs:comment xml:lang="en">Evidence record documents an attack tactic from MITRE ATT&amp;CK knowledge base.</rdfs:comment>
        <rdfs:label xml:lang="en">records attack tactic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#recordsAttackTechnique -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#recordsAttackTechnique">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#AttackTechnique"/>
        <rdfs:comment xml:lang="en">Evidence record documents an attack technique from MITRE ATT&amp;CK knowledge base.</rdfs:comment>
        <rdfs:label xml:lang="en">records attack technique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#recordsDocument -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#recordsDocument">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#Document"/>
        <rdfs:comment xml:lang="en">Evidence record documents a submitted document.</rdfs:comment>
        <rdfs:label xml:lang="en">records document</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#recordsEvent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#recordsEvent">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Event"/>
        <rdfs:comment xml:lang="en">Evidence record documents an event.</rdfs:comment>
        <rdfs:label xml:lang="en">records event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#recordsExecutionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#recordsExecutionOf">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#DCOPlaybook"/>
        <rdfs:comment xml:lang="en">Evidence record documents an execution of a DCO playbook.</rdfs:comment>
        <rdfs:label xml:lang="en">records execution of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#recordsMonitoringOutcome -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#recordsMonitoringOutcome">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#MonitoringOutcome"/>
        <rdfs:comment xml:lang="en">Evidence record documents a monitoring outcome.</rdfs:comment>
        <rdfs:label xml:lang="en">records monitoring outcome</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#recordsVulnerability -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#recordsVulnerability">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#CVE"/>
        <rdfs:comment xml:lang="en">Evidence record documents a vulnerability from CVE.</rdfs:comment>
        <rdfs:label xml:lang="en">records vulnerability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#recordsWeakness -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#recordsWeakness">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#CWE"/>
        <rdfs:comment xml:lang="en">Evidence record documents a weakness from CWE.</rdfs:comment>
        <rdfs:label xml:lang="en">records weakness</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#relatedToAttackTactic -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#relatedToAttackTactic">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#Attack"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#AttackTactic"/>
        <rdfs:comment xml:lang="en">Attack is related to an attack tactic from MITRE ATT&amp;CK knowledge base.</rdfs:comment>
        <rdfs:label xml:lang="en">related to attack tactic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#relatedToAttackTechnique -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#relatedToAttackTechnique">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#Attack"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#AttackTechnique"/>
        <rdfs:comment xml:lang="en">Attack is related to an attack technique from MITRE ATT&amp;CK knowledge base.</rdfs:comment>
        <rdfs:label xml:lang="en">related to attack technique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#simulatedOn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#simulatedOn">
        <owl:inverseOf rdf:resource="https://w3id.org/nis2onto-ops#simulates"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#SoftwareApplication"/>
        <rdfs:comment xml:lang="en">Asset can be simulated on a software application.</rdfs:comment>
        <rdfs:label xml:lang="en">simulated on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#simulates -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#simulates">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#SoftwareApplication"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:comment xml:lang="en">Software applicates can simulate an asset.</rdfs:comment>
        <rdfs:label xml:lang="en">simulates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#supportedByEvidenceRecord -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#supportedByEvidenceRecord">
        <owl:inverseOf rdf:resource="https://w3id.org/nis2onto-ops#supportsControlTheme"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:comment xml:lang="en">Control theme is supported by a compliance evidence record.</rdfs:comment>
        <rdfs:label xml:lang="en">supported by evidence record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#supportsControlTheme -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#supportsControlTheme">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:comment xml:lang="en">Evidence record records compliance to a control theme.</rdfs:comment>
        <rdfs:label xml:lang="en">supports control theme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/nis2onto-ops#usesRule -->

    <owl:ObjectProperty rdf:about="https://w3id.org/nis2onto-ops#usesRule">
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#ComplianceRule"/>
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#DetectionRule"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Entity uses a rule as a trigger or decision ruling.</rdfs:comment>
        <rdfs:label xml:lang="en">uses rule</rdfs:label>
    </owl:ObjectProperty>
    


