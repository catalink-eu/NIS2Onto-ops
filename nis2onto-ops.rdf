            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#relatedToENISATechnicalGuideSection"/>
                <owl:hasValue>2.2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Control theme covering the regular review of compliance with security policies, rules, and standards, and the reporting of compliance status to management bodies.</rdfs:comment>
        <rdfs:label xml:lang="en">Compliance Monitoring</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#ComplianceRule -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#ComplianceRule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#SecurityCatalogReference"/>
        <rdfs:comment xml:lang="en">Rule used to derive a control compliance ruling.</rdfs:comment>
        <rdfs:label xml:lang="en">Compliance Rule</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#ComputeHost -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#ComputeHost">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ITAsset"/>
        <rdfs:comment xml:lang="en">A physical or virtual machine that hosts software assets.</rdfs:comment>
        <rdfs:label xml:lang="en">Compute Host</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#ControlGovernance -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#ControlGovernance">
        <rdfs:comment xml:lang="en">Organizational grouping for the concepts used to define, scope, and evaluate compliance controls.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Governance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#ControlRuling -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#ControlRuling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlGovernance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#evidencedBy"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasControlScope"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#ControlScope"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasControlStatus"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#ControlStatus"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasRemediationScore"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#RemediationScore"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#usesRule"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#ComplianceRule"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasTimestamp"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Reified, auditable record of a single compliance judgement: the scope it evaluates, the evidence records it was computed from, the status it produced, and when and by which rule it was derived.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Ruling</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#ControlScope -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#ControlScope">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlGovernance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasInScopeAsset"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasInScopeControlTheme"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Boundary of a compliance evaluation, defined by the asset(s) and control theme(s) it covers.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Scope</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#ControlStatus -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#ControlStatus">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlGovernance"/>
        <rdfs:comment xml:lang="en">Outcome classification of a control derivation.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Status</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#ControlTheme -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#ControlTheme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlGovernance"/>
        <rdfs:comment xml:lang="en">A category of security controls, such as authentication or incident response, that compliance is evaluated against.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Theme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#Criticality -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#Criticality">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#RiskRating"/>
        <rdfs:comment xml:lang="en">Asset criticality classification: Critical, High, Medium, Low, or N/A.</rdfs:comment>
        <rdfs:label xml:lang="en">Criticality</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#CryptographicProtection -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#CryptographicProtection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#governedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Art21Par2-h-Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#relatedToENISATechnicalGuideSection"/>
                <owl:hasValue>9.1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Control theme covering the policy and use of cryptographic mechanisms to protect the confidentiality, integrity, and authenticity of data.</rdfs:comment>
        <rdfs:label xml:lang="en">Cryptographic Protection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#CybersecuritySoftwareApplication -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#CybersecuritySoftwareApplication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#SoftwareApplication"/>
        <rdfs:comment xml:lang="en">Software application dedicated to cybersecurity monitoring, detection, scanning, or protection.</rdfs:comment>
        <rdfs:label xml:lang="en">Cybersecurity Software Application</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#CybersecuritySoftwareModule -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#CybersecuritySoftwareModule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#SoftwareModule"/>
        <rdfs:comment xml:lang="en">Software module dedicated to cybersecurity monitoring, detection, scanning, or protection functions.</rdfs:comment>
        <rdfs:label xml:lang="en">Cybersecurity Software Module</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#DCOPlaybook -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#DCOPlaybook">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#SecurityCatalogReference"/>
        <rdfs:comment xml:lang="en">Defensive Cyber Operations playbook describing a predefined incident-response procedure.</rdfs:comment>
        <rdfs:label xml:lang="en">DCO Playbook</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#DataAsset -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#DataAsset">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ITAsset"/>
        <rdfs:label xml:lang="en">Data Asset</rdfs:label>
        <rdfs:label xml:lang="en">Stored data asset.</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#DataIntegrityAndTamperResistance -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#DataIntegrityAndTamperResistance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#governedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Art21Par2-b-Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#relatedToENISATechnicalGuideSection"/>
                <owl:hasValue>3.2.5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Control theme covering the protection of logs and recorded data from unauthorised access or modification.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Integrity and Tamper Resistance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#DetectionRule -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#DetectionRule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#SecurityCatalogReference"/>
        <rdfs:comment xml:lang="en">Rule used by a detection system to identify malicious or anomalous behavior.</rdfs:comment>
        <rdfs:label xml:lang="en">Detection Rule</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#Document -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#Document">
        <rdfs:subClassOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#NIS2GeneralOntologicalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasFileFormat"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#FileFormat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasFileName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasURL"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A documentary artifact, e.g. a policy, procedure, certificate, or report.</rdfs:comment>
        <rdfs:label xml:lang="en">Document</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#DocumentEvidenceRecord -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#DocumentEvidenceRecord">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#recordsDocument"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#Document"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:comment xml:lang="en">Evidence record documenting a submitted document.</rdfs:comment>
        <rdfs:label xml:lang="en">Document Evidence Record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#EventAnalysisAndClassification -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#EventAnalysisAndClassification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#governedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Art21Par2-b-Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#relatedToENISATechnicalGuideSection"/>
                <owl:hasValue>3.4</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Control theme covering the assessment of suspicious events to determine whether they constitute incidents and the classification of their nature and severity.</rdfs:comment>
        <rdfs:label xml:lang="en">Event Analysis and Classification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#EventEvidenceRecord -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#EventEvidenceRecord">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#recordsEvent"/>
                        <owl:someValuesFrom rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Event"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:comment xml:lang="en">Evidence record documenting the occurrence of an event.</rdfs:comment>
        <rdfs:label xml:lang="en">Event Evidence Record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#EvidenceRecord -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#EvidenceRecord">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#producedBy"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Assessment"/>
                            <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#SoftwareApplication"/>
                            <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#SoftwareModule"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasID"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasTimestamp"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Record capturing evidence collected during security monitoring, detection, or assessment.</rdfs:comment>
        <rdfs:label xml:lang="en">Evidence Record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#FileFormat -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#FileFormat">
        <rdfs:subClassOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#NIS2GeneralOntologicalEntity"/>
        <rdfs:comment xml:lang="en">Classification of file&apos;s type or encoding.</rdfs:comment>
        <rdfs:label xml:lang="en">File Format</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#HashAlgorithm -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#HashAlgorithm">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#HashComponent"/>
        <rdfs:comment xml:lang="en">Cryptographic algorithm used to compute a hash digest.</rdfs:comment>
        <rdfs:label xml:lang="en">Hash Algorithm</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#HashComponent -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#HashComponent">
        <rdfs:subClassOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#NIS2GeneralOntologicalEntity"/>
        <rdfs:comment xml:lang="en">Component involved in producing or representing a cryptographic hash.</rdfs:comment>
        <rdfs:label xml:lang="en">Hash Component</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#HashDigest -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#HashDigest">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#HashComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hashedUsing"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#HashAlgorithm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasHashValue"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Fixed-length value produced by applying a hash algorithm to data.</rdfs:comment>
        <rdfs:label xml:lang="en">Hash Digest</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#IOCMatching -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#IOCMatching">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#RuleBasedAssessment"/>
        <rdfs:comment xml:lang="en">Rule-based assessment that matches observed data against known Indicators of Compromise.</rdfs:comment>
        <rdfs:label xml:lang="en">IOC Matching</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#ITAsset -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#ITAsset">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:comment xml:lang="en">Information Technology asset such as a workstation, server, cloud instance, or software application.</rdfs:comment>
        <rdfs:label xml:lang="en">IT Asset</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#IncidentDetectionAndMonitoring -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#IncidentDetectionAndMonitoring">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#governedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Art21Par2-b-Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#relatedToENISATechnicalGuideSection"/>
                <owl:hasValue>3.2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Control theme covering the monitoring and logging of network and information systems to detect events that could constitute incidents.</rdfs:comment>
        <rdfs:label xml:lang="en">Incident Detection and Monitoring</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#IncidentResponseProcedure -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#IncidentResponseProcedure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#governedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Art21Par2-b-Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#relatedToENISATechnicalGuideSection"/>
                <owl:hasValue>3.5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Control theme covering the containment, eradication, and recovery procedures used to respond to incidents.</rdfs:comment>
        <rdfs:label xml:lang="en">Incidence Response Procedure</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#InjectionAttack -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#InjectionAttack">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#AssetAttack"/>
        <rdfs:comment xml:lang="en">Attack that injects malicious, falsified, or unauthorized data into an asset or communication channel.</rdfs:comment>
        <rdfs:label xml:lang="en">Injection Attack</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#IntegrityVerification -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#IntegrityVerification">
        <rdfs:subClassOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Assessment"/>
        <rdfs:comment xml:lang="en">Assessment method that confirms data or a component has not been tampered with.</rdfs:comment>
        <rdfs:label xml:lang="en">Integrity Verification</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#Ledger -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#Ledger">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#SoftwareApplication"/>
        <rdfs:comment xml:lang="en">Software application, such as a blockchain, that stores records for integrity and traceability.</rdfs:comment>
        <rdfs:label xml:lang="en">Ledger</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#LedgerAttestedEvidenceRecord -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#LedgerAttestedEvidenceRecord">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasHashDigest"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#HashDigest"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#recordedOnLedger"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#Ledger"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasBlockchainTxID"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#supportsControlTheme"/>
                <owl:hasValue rdf:resource="https://w3id.org/nis2onto-ops#ledger_evidence_recording"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Evidence record whose integrity is attested by a hash digest anchored to a ledger via a blockchain transaction ID.</rdfs:comment>
        <rdfs:label xml:lang="en">Ledger-Attested Evidence Record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#MISP -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#MISP">
        <rdfs:subClassOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#CybersecurityTool"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#CybersecuritySoftwareApplication"/>
        <rdfs:comment xml:lang="en">MISP (Malware Information Sharing Platform or Threat Sharing) is an open-source Threat Intelligence Platform (TIP) to store, share, and analyze Indicators of Compromise (IoCs).</rdfs:comment>
        <rdfs:label xml:lang="en">MISP</rdfs:label>
    </owl:Class>
    


