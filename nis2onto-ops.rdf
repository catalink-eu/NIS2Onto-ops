        <rdfs:comment xml:lang="en">Classification of how serious a vulnerability, weakness, or incident is.</rdfs:comment>
        <rdfs:label xml:lang="en">Severity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#SignatureMatching -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#SignatureMatching">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#RuleBasedAssessment"/>
        <rdfs:comment xml:lang="en">Rule-based assessment that matches observed data against known malicious signatures.</rdfs:comment>
        <rdfs:label xml:lang="en">Signature Matching</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#Snyk -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#Snyk">
        <rdfs:subClassOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#CybersecurityTool"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#CybersecuritySoftwareApplication"/>
        <rdfs:comment xml:lang="en">Snyk is a software security platform that scans source code, open-source dependencies, containers, and infrastructure configurations to find and automatically fix security flaws.</rdfs:comment>
        <rdfs:label xml:lang="en">Snyk</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#SoftwareApplication -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#SoftwareApplication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#SoftwareAsset"/>
        <rdfs:comment xml:lang="en">Software that is intended for end-user use.</rdfs:comment>
        <rdfs:label xml:lang="en">Software Application</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#SoftwareAsset -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#SoftwareAsset">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ITAsset"/>
        <rdfs:comment xml:lang="en">Software-related asset.</rdfs:comment>
        <rdfs:label xml:lang="en">Software Asset</rdfs:label>
    </owl:Class>
    


