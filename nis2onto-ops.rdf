        <rdfs:label xml:lang="en">has alert timestamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasBlockchainTxID -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#hasBlockchainTxID">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Blockchain transcaction id string.</rdfs:comment>
        <rdfs:label xml:lang="en">has blockchain transaction ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasCVSSScore -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#hasCVSSScore">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Float Common Vulnerability Scoring System (CVSS) score.</rdfs:comment>
        <rdfs:label xml:lang="en">has CVSS score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasEndpoint -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#hasEndpoint">
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#SoftwareAsset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Software endpoint string.</rdfs:comment>
        <rdfs:label xml:lang="en">has endpoint</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasFileName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#hasFileName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">File name string.</rdfs:comment>
        <rdfs:label xml:lang="en">has file name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasHashValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#hasHashValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#HashDigest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Hash value string.</rdfs:comment>
        <rdfs:label xml:lang="en">has hash value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasID -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#hasID">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">ID string.</rdfs:comment>
        <rdfs:label xml:lang="en">has ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasScoreGrade -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#hasScoreGrade">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Grade score value.</rdfs:comment>
        <rdfs:label xml:lang="en">has score grade</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasScoreValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#hasScoreValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Float score value.</rdfs:comment>
        <rdfs:label xml:lang="en">has score value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasTimestamp -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#hasTimestamp">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Datetime timestamp record.</rdfs:comment>
        <rdfs:label xml:lang="en">has timestamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#hasURL -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#hasURL">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">URL string.</rdfs:comment>
        <rdfs:label xml:lang="en">has URL</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#isConvertedToValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#isConvertedToValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Non-numerical entry converted to a numerical value.</rdfs:comment>
        <rdfs:label xml:lang="en">is converted to value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#isSimulatedAsset -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#isSimulatedAsset">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean for a an asset to be declared as a simulated asset.</rdfs:comment>
        <rdfs:label xml:lang="en">is simulated asset</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#notes -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#notes">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Note field string.</rdfs:comment>
        <rdfs:label xml:lang="en">notes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/nis2onto-ops#relatedToENISATechnicalGuideSection -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/nis2onto-ops#relatedToENISATechnicalGuideSection">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">ENISA technical guide section string.</rdfs:comment>
        <rdfs:label xml:lang="en">related to ENISA technical guide section</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/nis2onto-ops#AlertEvidenceRecord -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#AlertEvidenceRecord">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasSeverity"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#Severity"/>
                            <owl:Class>
                                <owl:complementOf>
                                    <owl:Class>
                                        <owl:oneOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#info_severity"/>
                                        </owl:oneOf>
                                    </owl:Class>
                                </owl:complementOf>
                            </owl:Class>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#supportsControlTheme"/>
                <owl:hasValue rdf:resource="https://w3id.org/nis2onto-ops#severity_classification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Evidence record documenting a security alert that was triggered.</rdfs:comment>
        <rdfs:label xml:lang="en">Alert Evidence Record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#AnomalyDetection -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#AnomalyDetection">
        <rdfs:subClassOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Assessment"/>
        <rdfs:comment xml:lang="en">Assessment method that identifies deviations from expected or normal behavior.</rdfs:comment>
        <rdfs:label xml:lang="en">Anomaly Detection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#ArterySimulator -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#ArterySimulator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#CAVSimulator"/>
        <rdfs:comment xml:lang="en">Artery communication simulator (V2X).</rdfs:comment>
        <rdfs:label xml:lang="en">Artery Simulator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#Asset -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#Asset">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasCriticality"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#Criticality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#hasID"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Any IT, OT, or CAV component, system, or service that is part of the monitored environment.</rdfs:comment>
        <rdfs:label xml:lang="en">Asset</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#AssetAttack -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#AssetAttack">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#Attack"/>
        <rdfs:comment xml:lang="en">Attack directed at a specific asset.</rdfs:comment>
        <rdfs:label xml:lang="en">Asset Attack</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#AssetEvent -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#AssetEvent">
        <rdfs:subClassOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Event"/>
        <rdfs:comment xml:lang="en">Event that occurs on, or involves, an asset.</rdfs:comment>
        <rdfs:label xml:lang="en">Asset Event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#AssetEvidenceRecord -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#AssetEvidenceRecord">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#assessesAsset"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#Asset"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#supportsControlTheme"/>
                <owl:hasValue rdf:resource="https://w3id.org/nis2onto-ops#asset_evidence_documentation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Evidence record documenting the assessment of an asset.</rdfs:comment>
        <rdfs:label xml:lang="en">Asset Evidence Record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#AssetInventoryAndManagement -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#AssetInventoryAndManagement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#governedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Art21Par2-i-Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#relatedToENISATechnicalGuideSection"/>
                <owl:hasValue>12.4</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Control theme covering the identification, inventory, and lifecycle tracking of assets relevant to the security of network and information systems.</rdfs:comment>
        <rdfs:label xml:lang="en">Asset Inventory and Management</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#AssetOwner -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#AssetOwner">
        <rdfs:subClassOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Actor"/>
        <rdfs:comment xml:lang="en">Entity that holds legal, operational, or financial rights to an asset.</rdfs:comment>
        <rdfs:label xml:lang="en">Asset Owner</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#Attack -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#Attack">
        <rdfs:subClassOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Incident"/>
        <rdfs:comment xml:lang="en">Malicious event that attempts to compromise the confidentiality, integrity, or availability of an asset.</rdfs:comment>
        <rdfs:label xml:lang="en">Attack</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#AttackEvidenceRecord -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#AttackEvidenceRecord">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#recordsEvent"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#Attack"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#EventEvidenceRecord"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#supportsControlTheme"/>
                <owl:hasValue rdf:resource="https://w3id.org/nis2onto-ops#component_integrity_evaluation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Evidence record documenting the occurrence of an attack.</rdfs:comment>
        <rdfs:label xml:lang="en">Attack Evidence Record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#AttackTactic -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#AttackTactic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#SecurityCatalogReference"/>
        <rdfs:comment xml:lang="en">An adversary&apos;s tactical objective (the &apos;why&apos; of an attack), drawn from the MITRE ATT&amp;CK knowledge base.</rdfs:comment>
        <rdfs:label xml:lang="en">Attack Tactic</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#AttackTechnique -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#AttackTechnique">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#SecurityCatalogReference"/>
        <rdfs:comment xml:lang="en">A documented, adversary behavior describing how an attacker achieves a tactical objective, drawn from the MITRE ATT&amp;CK knowledge base.</rdfs:comment>
        <rdfs:label xml:lang="en">Attack Technique</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#AuthenticationAndAccessControl -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#AuthenticationAndAccessControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
