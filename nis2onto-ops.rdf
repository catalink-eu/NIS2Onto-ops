                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Quantified measure of an entity&apos;s overall security posture.</rdfs:comment>
        <rdfs:label xml:lang="en">Posture Score</rdfs:label>
    </owl:Class>
    


