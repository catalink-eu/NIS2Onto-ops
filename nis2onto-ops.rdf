                <owl:hasValue rdf:resource="https://w3id.org/nis2onto-ops#component_integrity_evaluation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Evidence record documenting a monitoring outcome.</rdfs:comment>
