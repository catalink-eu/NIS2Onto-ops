    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/nis2onto-ops#CROSSCORE -->

    <owl:NamedIndividual rdf:about="https://w3id.org/nis2onto-ops#CROSSCORE">
        <rdf:type rdf:resource="https://w3id.org/nis2onto-ops#CybersecuritySoftwareModule"/>
        <nis2onto-ops:hasCriticality rdf:resource="https://w3id.org/nis2onto-ops#n_a"/>
        <nis2onto-ops:hasID>CROSSCORE</nis2onto-ops:hasID>
        <rdfs:comment xml:lang="en">CYberSynchrony module that facilitates secure, cross-border cooperation during cyber incidents. Blockchain technology ensures data integrity, enabling reliable information sharing among MS.</rdfs:comment>
        <rdfs:label xml:lang="en">CROSSCORE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/nis2onto-ops#CYBERGOPLUS -->

    <owl:NamedIndividual rdf:about="https://w3id.org/nis2onto-ops#CYBERGOPLUS">
