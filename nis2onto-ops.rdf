    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#SoftwareModule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#SoftwareAsset"/>
        <rdfs:comment xml:lang="en">Software unit responsible for a specific function.</rdfs:comment>
        <rdfs:label xml:lang="en">Software Module</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#StreamPatternMatching -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#StreamPatternMatching">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#RuleBasedAssessment"/>
        <rdfs:comment xml:lang="en">Rule-based assessment that matches patterns within a continuous data stream.</rdfs:comment>
        <rdfs:label xml:lang="en">Stream Pattern Matching</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#SupplyChainSecurity -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#SupplyChainSecurity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#governedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Art21Par2-d-Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#relatedToENISATechnicalGuideSection"/>
                <owl:hasValue>5.1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Control theme covering the identification and management of risks arising from suppliers, service providers, and third-party software components in the network and information systems supply chain.</rdfs:comment>
        <rdfs:label xml:lang="en">Supply Chain Security</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#Suricata -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#Suricata">
        <rdfs:subClassOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#CybersecurityTool"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#CybersecuritySoftwareApplication"/>
        <rdfs:comment xml:lang="en">Suricata is an open-source Network Intrusion Detection System (NIDS), Intrusion Prevention System (IPS), and Network Security Monitoring (NSM) engine that performs deep packet inspection and watches network traffic for malicious patterns, policy violations, and suspicious anomalies.</rdfs:comment>
        <rdfs:label xml:lang="en">Suricata</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#ThreatEvidenceRecord -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#ThreatEvidenceRecord">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#recordsAttackTactic"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#AttackTactic"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#recordsAttackTechnique"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#AttackTechnique"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#CTIEnrichedEvidenceRecord"/>
        <rdfs:comment xml:lang="en">Evidence record documenting an attack tactic or technique from the MITRE ATT&amp;CK knowledge base.</rdfs:comment>
        <rdfs:label xml:lang="en">Threat Evidence Record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#VulnerabilityEvidenceRecord -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#VulnerabilityEvidenceRecord">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#recordsVulnerability"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#CVE"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#recordsWeakness"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/nis2onto-ops#CWE"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#CTIEnrichedEvidenceRecord"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#supportsControlTheme"/>
                <owl:hasValue rdf:resource="https://w3id.org/nis2onto-ops#cve_cwe_disclosure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Evidence record documenting a vulnerability/weakness from a CVE/CWE.</rdfs:comment>
        <rdfs:label xml:lang="en">Vulnerability Evidence Record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#VulnerabilityHandlingAndDisclosure -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#VulnerabilityHandlingAndDisclosure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#governedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Art21Par2-e-Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#relatedToENISATechnicalGuideSection"/>
                <owl:hasValue>6.10</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Control theme covering the identification, handling, and coordinated disclosure of vulnerabilities affecting network and information systems.</rdfs:comment>
        <rdfs:label xml:lang="en">Vulnerability Handling and Disclosure</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#Wazuh -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#Wazuh">
        <rdfs:subClassOf rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#CybersecurityTool"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#CybersecuritySoftwareApplication"/>
        <rdfs:comment xml:lang="en">Wazuh is an open-source, enterprise-grade security monitoring platform that uses agents to collect, analyze, and correlate logs in real-time, offering file integrity monitoring, vulnerability detection, and incident response.</rdfs:comment>
        <rdfs:label xml:lang="en">Wazuh</rdfs:label>
    </owl:Class>
    


