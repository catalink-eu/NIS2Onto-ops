            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Control theme covering the policies and procedures used to assess the effectiveness of implemented cybersecurity risk-management measures.</rdfs:comment>
        <rdfs:label xml:lang="en">Security Posture and Control Effectiveness</rdfs:label>
    </owl:Class>
    


