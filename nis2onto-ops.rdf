        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#EvidenceRecord"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#producedBy"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#MISP"/>
                            <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#Snyk"/>
                            <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#Suricata"/>
                            <rdf:Description rdf:about="https://w3id.org/nis2onto-ops#Wazuh"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#supportsControlTheme"/>
                <owl:hasValue rdf:resource="https://w3id.org/nis2onto-ops#cti_enrichment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Evidence record enriched by external CTI (Cyber Threat Intelligence).</rdfs:comment>
        <rdfs:label xml:lang="en">CTI-Enriched Evidence Record</rdfs:label>
    </owl:Class>
    


