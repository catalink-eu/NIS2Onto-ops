    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#SecurityCatalogReference">
        <rdfs:comment xml:lang="en">Reference to an entry in an external security catalog or knowledge base, such as CVE or CWE.</rdfs:comment>
        <rdfs:label xml:lang="en">Security Catalog Reference</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/nis2onto-ops#SecurityPostureAndControlEffectiveness -->

    <owl:Class rdf:about="https://w3id.org/nis2onto-ops#SecurityPostureAndControlEffectiveness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/nis2onto-ops#ControlTheme"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/nis2onto-ops#governedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.unict.it/nas-inf/nis2onto/nis2onto.owl#Art21Par2-f-Entity"/>
